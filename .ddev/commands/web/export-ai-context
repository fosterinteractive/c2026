#!/usr/bin/env bash
## Description: Export all AI Context items and usage records into the ai_context_setup recipe.
## Usage: export-ai-context
## Example: ddev export-ai-context

set -euo pipefail

RECIPE_CONTENT_DIR="custom_recipes/ai_context_setup/content"
EXPORT_CMD="php web/core/scripts/drupal content:export"

echo "==> Clearing existing ai_context_item exports..."
rm -rf "${RECIPE_CONTENT_DIR}/ai_context_item"

echo "==> Clearing existing ai_context_usage exports..."
rm -rf "${RECIPE_CONTENT_DIR}/ai_context_usage"

echo "==> Exporting all ai_context_item entities..."
${EXPORT_CMD} ai_context_item --dir="${RECIPE_CONTENT_DIR}"

echo "==> Exporting all ai_context_usage entities..."
${EXPORT_CMD} ai_context_usage --dir="${RECIPE_CONTENT_DIR}"

ITEM_COUNT=$(find "${RECIPE_CONTENT_DIR}/ai_context_item" -name '*.yml' 2>/dev/null | wc -l | tr -d ' ')
USAGE_COUNT=$(find "${RECIPE_CONTENT_DIR}/ai_context_usage" -name '*.yml' 2>/dev/null | wc -l | tr -d ' ')

echo ""
echo "==> Export complete:"
echo "    Context items: ${ITEM_COUNT}"
echo "    Usage records: ${USAGE_COUNT}"
echo "    Output:        ${RECIPE_CONTENT_DIR}"
