#!/usr/bin/env bash
## Description: Recreate the DDEV project, install dependencies, remove canvas module, and print a login URL.
## Usage: demo-setup

set -euo pipefail

ddev delete -O -y
ddev start
ddev composer install

# Canvas is currently required as a dev release. Composer installs dev modules from
# their Git repository, and we also apply a patch to Canvas. That makes Git think
# many files in web/modules/contrib/canvas are changed, which clutters IDE sidebars.
# Remove the module's .git directory as a workaround.
rm -rf web/modules/contrib/canvas/.git

## This recipe was generated with the command  ddev drush site:export --destination=../custom_recipes/findrop
ddev drush si ../custom_recipes/findrop -y

ddev drush en ai_context -y
ddev drush recipe ../custom_recipes/ai_context_setup

echo "Building Canvas UI assets..."
REQUIRED_NODE_MAJOR=20
REQUIRED_NODE_MINOR=19
NODE_VERSION=$(node --version 2>/dev/null | sed 's/v//')
if [ -z "$NODE_VERSION" ]; then
  echo "Error: Node.js is not installed. Please install Node.js >= ${REQUIRED_NODE_MAJOR}.${REQUIRED_NODE_MINOR}.0 to continue."
  exit 1
fi
NODE_MAJOR=$(echo "$NODE_VERSION" | cut -d. -f1)
NODE_MINOR=$(echo "$NODE_VERSION" | cut -d. -f2)
if [ "$NODE_MAJOR" -lt "$REQUIRED_NODE_MAJOR" ] || { [ "$NODE_MAJOR" -eq "$REQUIRED_NODE_MAJOR" ] && [ "$NODE_MINOR" -lt "$REQUIRED_NODE_MINOR" ]; }; then
  echo "Error: Node.js ${NODE_VERSION} is below the required version ${REQUIRED_NODE_MAJOR}.${REQUIRED_NODE_MINOR}.0."
  echo "Please update Node.js before running demo-setup."
  exit 1
fi
(cd web/modules/contrib/canvas && npm install)
(cd web/modules/contrib/canvas/ui && npm run build)

echo "Preparing to index content..."
sleep 3
echo "Indexing all content in the vector database..."
ddev drush sapi-i

# Install ai_google_analytics module.
echo "Installing content performance modules..."
ddev drush en ai_google_analytics -y

echo "Demo setup complete. You can log in to the Drupal site using the following URL:"
ddev drush uli
