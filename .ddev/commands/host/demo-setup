#!/usr/bin/env bash
## Description: Recreate the DDEV project, install dependencies, check out the Canvas POC branch, and print a login URL.
## Usage: demo-setup

set -euo pipefail

ddev delete -O -y || true   # tolerate first run (project not yet registered)
ddev start
ddev composer install

# Canvas's POC code (client-side AI orchestration — MR !1214 / d.o issue 3591615) is
# supplied by checking out its issue-fork branch as a real git branch, NOT by a composer
# URL patch. The MR is open and actively updated, so a hash-pinned patch (the old
# patches.lock.json approach) breaks on every MR change. `composer install` above brings
# in base Canvas (pinned dev commit); the checkout below overlays the POC branch on top
# and gives us an editable, committable branch for Canvas development.
CANVAS_DIR="web/modules/contrib/canvas"
CANVAS_FORK_URL="https://git.drupalcode.org/issue/canvas-3591615.git"
CANVAS_POC_BRANCH="3591615-canvas-ai-client-side-orchestration-loop-for-canvas-aipoc"
CANVAS_LOCAL_BRANCH="canvas-ai-work"
echo "Checking out Canvas POC branch (${CANVAS_POC_BRANCH})..."
git -C "$CANVAS_DIR" remote get-url poc >/dev/null 2>&1 || git -C "$CANVAS_DIR" remote add poc "$CANVAS_FORK_URL"
git -C "$CANVAS_DIR" fetch poc "$CANVAS_POC_BRANCH"
if git -C "$CANVAS_DIR" show-ref --verify --quiet "refs/heads/${CANVAS_LOCAL_BRANCH}" \
   && [ "$(git -C "$CANVAS_DIR" rev-list --count "poc/${CANVAS_POC_BRANCH}..${CANVAS_LOCAL_BRANCH}")" -gt 0 ]; then
  # Local dev commits exist ahead of the POC branch — keep them, don't reset.
  echo "  '${CANVAS_LOCAL_BRANCH}' has local commits ahead of the POC branch; leaving it intact."
  git -C "$CANVAS_DIR" checkout "$CANVAS_LOCAL_BRANCH"
else
  git -C "$CANVAS_DIR" checkout -B "$CANVAS_LOCAL_BRANCH" "poc/${CANVAS_POC_BRANCH}"
fi

## This recipe was generated with the command  ddev drush site:export --destination=../custom_recipes/findrop
ddev drush si ../custom_recipes/findrop -y

ddev drush en ai_context -y
ddev drush recipe ../custom_recipes/ai_context_setup

echo "Building Canvas UI assets..."
REQUIRED_NODE_MAJOR=20
REQUIRED_NODE_MINOR=19
NODE_VERSION=$(node --version 2>/dev/null | sed 's/v//')
if [ -z "$NODE_VERSION" ]; then
  echo "Error: Node.js is not installed. Please install Node.js >= ${REQUIRED_NODE_MAJOR}.${REQUIRED_NODE_MINOR}.0 to continue."
  exit 1
fi
NODE_MAJOR=$(echo "$NODE_VERSION" | cut -d. -f1)
NODE_MINOR=$(echo "$NODE_VERSION" | cut -d. -f2)
if [ "$NODE_MAJOR" -lt "$REQUIRED_NODE_MAJOR" ] || { [ "$NODE_MAJOR" -eq "$REQUIRED_NODE_MAJOR" ] && [ "$NODE_MINOR" -lt "$REQUIRED_NODE_MINOR" ]; }; then
  echo "Error: Node.js ${NODE_VERSION} is below the required version ${REQUIRED_NODE_MAJOR}.${REQUIRED_NODE_MINOR}.0."
  echo "Please update Node.js before running demo-setup."
  exit 1
fi
(cd web/modules/contrib/canvas && npm install)
(cd web/modules/contrib/canvas/ui && npm run build)

echo "Preparing to index content..."
sleep 3
echo "Indexing all content in the vector database..."
for attempt in 1 2 3 4 5; do
  ddev drush sapi-i || true
  remaining=$(ddev drush sapi-s 2>/dev/null | awk '$(NF) ~ /^[0-9]+$/ {sum += $(NF) - $(NF-1)} END {print sum+0}')
  if [ "${remaining:-0}" -eq 0 ]; then
    break
  fi
  sleep_for=$((attempt * 15))
  echo "Retrying ($attempt) — ${remaining} item(s) remaining. Sleeping ${sleep_for}s..."
  sleep $sleep_for
done

echo "Demo setup complete. You can log in to the Drupal site using the following URL:"
ddev drush uli
