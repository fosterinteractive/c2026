+
+    // Skip context injection for loop-aware agents on iterations > 0.
+    // The LLM already holds context blocks from loop 0 in its conversation
+    // history. Re-injecting them wastes 40-60% of prompt tokens per loop.
+    // loop_aware defaults to FALSE so existing agents are unaffected.
+    if ($agentId) {
+      $agentConfigs = $this->configFactory->get('ai_context.agents')->get('agents') ?? [];
+      foreach ($agentConfigs as $agentConfig) {
+        if (($agentConfig['id'] ?? '') === $agentId) {
+          $loopAware = $agentConfig['loop_aware'] ?? FALSE;
+          $currentLoop = $this->loopCounts[$agentId] ?? 0;
+          if ($loopAware && $currentLoop > 0) {
+            return;
+          }
+          break;
+        }
+      }
+    }

