+    expect(state.plannedComponents).to.deep.equal([]);
+    expect(state.placedCount).to.eq(0);
+    expect(selectRemainingPlan(root(state))).to.deep.equal([]);
+  });
+
+  it('ignores planReceived when the plan_skeletons flag is off', async () => {
+    // The slice reads the flags once at module scope, so re-mock the globals and
+    // re-import a fresh copy of the slice with plan skeletons disabled.
+    vi.resetModules();
+    vi.doMock('@/utils/drupal-globals', () => ({
+      getBuildStateFlags: () => ({
+        build_lock: true,
+        build_glow: true,
+        smart_lock_timing: true,
+        plan_skeletons: false,
+      }),
+    }));
+    const mod = await import('@/features/aiBuild/aiBuildSlice');
+    let state = mod.aiBuildSlice.reducer(
+      mod.initialState,
+      mod.buildStarted({ requestId: 'req_1' }),
+    );
+    state = mod.aiBuildSlice.reducer(state, mod.planReceived(plan));
+    // Flag off → the plan is ignored and no state is stored.
+    expect(state.plannedComponents).to.deep.equal([]);
+    expect(state.placedCount).to.eq(0);
+    expect(mod.selectRemainingPlan({ aiBuild: state })).to.deep.equal([]);
+    vi.doUnmock('@/utils/drupal-globals');
