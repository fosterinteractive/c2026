+/**
+ * "AI is working" viewport glow (Phase 2, flag build_glow).
+ *
+ * A static cyan-blue border glow hugging the outer edge of the page frame while
+ * the AI builds: a crisp inner stroke plus a soft outer halo, drawn as a
+ * box-shadow on one decorative element inset just outside the frame. Nothing
+ * animates — the only movement is a gentle opacity fade in when a build starts
+ * and out when it ends, driven by the `visible` class BuildGlow toggles.
+ */
+.glow {
+  position: absolute;
+  z-index: 1; /* decorative: below the lock overlay (100) and the progress bar (2) */
+  transition: opacity 350ms ease;
+  pointer-events: none;
+  opacity: 0;
+  border-radius: inherit;
+  box-shadow:
+    0 0 0 3px rgb(56, 189, 248, 0.9),
+    0 0 28px 6px rgb(56, 189, 248, 0.55);
+  inset: -3px;
+}
+
+.glow.visible {
+  opacity: 1;
+}
