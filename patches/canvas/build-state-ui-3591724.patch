+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\canvas_ai\Kernel\Plugin\AiFunctionCall;
+
+use Drupal\canvas_ai\Plugin\AiFunctionCall\LockViewport;
+use Drupal\Tests\canvas\Kernel\CanvasKernelTestBase;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\Group;
+
+/**
+ * Tests Drupal\canvas_ai\Plugin\AiFunctionCall\LockViewport.
+ */
+#[CoversClass(LockViewport::class)]
+#[Group('canvas_ai')]
+final class LockViewportTest extends CanvasKernelTestBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'ai',
+    'ai_agents',
+    'canvas_ai',
+  ];
+
+  /**
+   * Tests the marker tool instantiates and executes as a no-op signal.
+   */
+  public function test(): void {
+    $function_call_manager = $this->container->get('plugin.manager.ai.function_calls');
+    $tool = $function_call_manager->createInstance('canvas_ai:lock_viewport');
+    self::assertInstanceOf(LockViewport::class, $tool);
+    $tool->execute();
+    $output = $tool->getReadableOutput();
+
+    self::assertStringContainsStringIgnoringCase('locked', $output);
+  }
+
+}
diff --git a/modules/canvas_ai/tests/src/Kernel/Plugin/AiFunctionCall/SetBuildPlanTest.php b/modules/canvas_ai/tests/src/Kernel/Plugin/AiFunctionCall/SetBuildPlanTest.php
new file mode 100644
index 0000000..38eae36
--- /dev/null
+++ b/modules/canvas_ai/tests/src/Kernel/Plugin/AiFunctionCall/SetBuildPlanTest.php
@@ -0,0 +1,112 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\canvas_ai\Kernel\Plugin\AiFunctionCall;
+
+use Drupal\canvas_ai\Plugin\AiFunctionCall\SetBuildPlan;
+use Drupal\Tests\canvas\Kernel\CanvasKernelTestBase;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\Group;
+use Symfony\Component\Yaml\Yaml;
+
+/**
+ * Tests Drupal\canvas_ai\Plugin\AiFunctionCall\SetBuildPlan.
+ */
+#[CoversClass(SetBuildPlan::class)]
+#[Group('canvas_ai')]
+final class SetBuildPlanTest extends CanvasKernelTestBase {
+
+  /**
+   * The function call plugin manager.
+   *
+   * @var \Drupal\Component\Plugin\PluginManagerInterface
+   */
+  protected $functionCallManager;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'ai',
+    'ai_agents',
+    'canvas_ai',
+  ];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+    $this->functionCallManager = $this->container->get('plugin.manager.ai.function_calls');
+  }
+
+  /**
+   * A valid YAML plan is stored as ordered structured output.
+   */
+  public function testValidPlan(): void {
+    $tool = $this->functionCallManager->createInstance('canvas_ai:set_build_plan');
+    self::assertInstanceOf(SetBuildPlan::class, $tool);
+
+    $plan = Yaml::dump([
+      ['component_id' => 'sdc.canvas_test_sdc.my-hero', 'title' => 'Hero'],
+      ['component_id' => 'sdc.canvas_test_sdc.my-features', 'title' => 'Features'],
+    ]);
+    $tool->setContextValue('plan', $plan);
+    $tool->execute();
+
+    $result = $tool->getStructuredOutput();
+    self::assertArrayHasKey('build_plan', $result);
+    self::assertSame([
+      ['component_id' => 'sdc.canvas_test_sdc.my-hero', 'title' => 'Hero'],
+      ['component_id' => 'sdc.canvas_test_sdc.my-features', 'title' => 'Features'],
+    ], $result['build_plan']);
+    // The confirmation re-asserts the continuation rule.
+    self::assertStringContainsStringIgnoringCase('continuation point', $tool->getReadableOutput());
+  }
+
+  /**
+   * A section with no component_id is kept with a null component_id.
+   */
+  public function testPlanWithOptionalComponentId(): void {
+    $tool = $this->functionCallManager->createInstance('canvas_ai:set_build_plan');
+    $plan = Yaml::dump([
+      ['title' => 'Hero'],
+    ]);
+    $tool->setContextValue('plan', $plan);
+    $tool->execute();
+
+    $result = $tool->getStructuredOutput();
+    self::assertSame([
+      ['component_id' => NULL, 'title' => 'Hero'],
+    ], $result['build_plan']);
+  }
+
+  /**
+   * An empty plan produces an error and no structured output.
+   */
+  public function testEmptyPlan(): void {
+    $tool = $this->functionCallManager->createInstance('canvas_ai:set_build_plan');
+    $tool->setContextValue('plan', '');
+    $tool->execute();
+
+    self::assertSame([], $tool->getStructuredOutput());
+    self::assertStringContainsStringIgnoringCase('Failed to record the build plan', $tool->getReadableOutput());
+  }
+
+  /**
+   * A section missing its title produces an error and no structured output.
+   */
+  public function testInvalidPlanMissingTitle(): void {
+    $tool = $this->functionCallManager->createInstance('canvas_ai:set_build_plan');
+    $plan = Yaml::dump([
+      ['component_id' => 'sdc.canvas_test_sdc.my-hero'],
+    ]);
+    $tool->setContextValue('plan', $plan);
+    $tool->execute();
+
+    self::assertSame([], $tool->getStructuredOutput());
+    self::assertStringContainsStringIgnoringCase('title', $tool->getReadableOutput());
+  }
+
+}
