@@ -0,0 +1,629 @@
+import {
+  aiBuildSlice,
+  buildEnded,
+  buildPaused,
+  buildResumed,
+  buildReverted,
+  buildStarted,
+  componentPlaced,
+  hopReceived,
+  inferPlanSectionSize,
+  initialState,
+  planReceived,
+  selectActiveComponentUuid,
+  selectBuildStatus,
+  selectFollowEdits,
+  selectIsBuildActive,
+  selectIsCanvasLocked,
+  selectIsGlowing,
+  selectIsPerComponentSpotlightActive,
+  selectLastRevertedAt,
+  selectPlacedCount,
+  selectPlannedComponents,
+  selectRemainingPlan,
+  selectTurnSnapshot,
+  setActiveComponent,
+  setFollowEdits,
+  snapshotConsumed,
+} from '@/features/aiBuild/aiBuildSlice';
+
+const reducer = aiBuildSlice.reducer;
+
+// Wraps slice state as the root state shape the slice selectors expect.
+const root = (aiBuild) => ({ aiBuild });
+
+describe('aiBuild lifecycle transitions', () => {
+  it('buildStarted engages the lock and records the request', () => {
+    const state = reducer(initialState, buildStarted({ requestId: 'req_1' }));
+    expect(state.status).to.eq('building');
+    expect(state.locked).to.eq(true);
+    expect(state.requestId).to.eq('req_1');
+    expect(typeof state.startedAt).to.eq('number');
+  });
+
+  it('hopReceived merges tool ids without changing the lock', () => {
+    let state = reducer(initialState, buildStarted({ requestId: 'req_1' }));
+    state = reducer(
+      state,
+      hopReceived({ toolsSelected: ['place_components'] }),
+    );
+    state = reducer(
+      state,
+      hopReceived({ toolsSelected: ['place_components', 'edit_components'] }),
+    );
+    expect(state.toolsSelected).to.deep.equal([
+      'place_components',
+      'edit_components',
+    ]);
+    // Phase 1: the whole turn stays locked regardless of hops.
+    expect(state.locked).to.eq(true);
+    expect(state.status).to.eq('building');
+  });
+
+  it('hopReceived with an empty payload is a no-op for tools', () => {
+    let state = reducer(initialState, buildStarted({ requestId: 'req_1' }));
+    state = reducer(state, hopReceived({}));
+    expect(state.toolsSelected).to.deep.equal([]);
+    expect(state.locked).to.eq(true);
+  });
+
+  it('buildPaused and buildResumed toggle status but keep the lock', () => {
+    let state = reducer(initialState, buildStarted({ requestId: 'req_1' }));
+    state = reducer(state, buildPaused());
+    expect(state.status).to.eq('paused');
+    expect(state.locked).to.eq(true);
+    state = reducer(state, buildResumed());
+    expect(state.status).to.eq('building');
+    expect(state.locked).to.eq(true);
+  });
+
+  it('setFollowEdits updates the flag and selectFollowEdits reads it', () => {
+    // Defaults on (stakeholder decision: the toggle starts ON).
+    expect(selectFollowEdits(root(initialState))).to.eq(true);
+    const off = reducer(initialState, setFollowEdits(false));
+    expect(off.followEdits).to.eq(false);
+    expect(selectFollowEdits(root(off))).to.eq(false);
+    const on = reducer(off, setFollowEdits(true));
+    expect(selectFollowEdits(root(on))).to.eq(true);
+  });
+
+  it('followEdits persists across buildEnded', () => {
+    let state = reducer(initialState, buildStarted({ requestId: 'req_1' }));
+    state = reducer(state, setFollowEdits(false));
+    state = reducer(state, buildEnded());
+    // The user's toggle choice is remembered for the next build.
+    expect(selectFollowEdits(root(state))).to.eq(false);
+  });
+});
+
+describe('aiBuild pause/resume semantics (Phase 4)', () => {
+  it('keeps the canvas locked and glowing while paused', () => {
+    let state = reducer(initialState, buildStarted({ requestId: 'req_1' }));
+    state = reducer(state, buildPaused());
+    expect(state.status).to.eq('paused');
+    // The lock and glow are held deliberately while paused.
+    expect(selectIsCanvasLocked(root(state))).to.eq(true);
+    expect(selectIsGlowing(root(state))).to.eq(true);
+  });
+
+  it('buildPaused from idle is a no-op', () => {
+    const state = reducer(initialState, buildPaused());
+    expect(state.status).to.eq('idle');
+  });
+
+  it('buildResumed from building is a no-op', () => {
+    let state = reducer(initialState, buildStarted({ requestId: 'req_1' }));
+    state = reducer(state, buildResumed());
+    expect(state.status).to.eq('building');
+  });
+});
+
+describe('aiBuild fail-open on buildEnded', () => {
+  it('resets to idle/unlocked from the building state', () => {
+    let state = reducer(initialState, buildStarted({ requestId: 'req_1' }));
+    state = reducer(
+      state,
+      hopReceived({ toolsSelected: ['place_components'] }),
+    );
+    state = reducer(state, buildEnded());
+    expect(state.status).to.eq('idle');
+    expect(state.locked).to.eq(false);
+    expect(state.requestId).to.eq(null);
+    expect(state.startedAt).to.eq(null);
+    expect(state.toolsSelected).to.deep.equal([]);
+  });
+
+  it('resets to idle/unlocked from the paused state', () => {
+    let state = reducer(initialState, buildStarted({ requestId: 'req_1' }));
+    state = reducer(state, buildPaused());
+    state = reducer(state, buildEnded());
+    expect(state.status).to.eq('idle');
+    expect(state.locked).to.eq(false);
+  });
+
+  it('preserves followEdits and turnSnapshot across buildEnded', () => {
+    const active = {
+      ...initialState,
+      status: 'building',
+      locked: true,
+      followEdits: false,
+      turnSnapshot: { layout: 'snapshot' },
+      toolsSelected: ['place_components'],
+    };
+    const state = reducer(active, buildEnded());
+    expect(state.status).to.eq('idle');
+    expect(state.locked).to.eq(false);
+    // Preserved across the turn boundary.
+    expect(state.followEdits).to.eq(false);
+    expect(state.turnSnapshot).to.deep.equal({ layout: 'snapshot' });
+    // Turn-scoped fields are reset.
+    expect(state.toolsSelected).to.deep.equal([]);
+  });
+});
+
+describe('aiBuild turn snapshot (Phase 5)', () => {
+  const snapshotA = { layout: ['layout-a'], model: { a: 1 } };
+  const snapshotB = { layout: ['layout-b'], model: { b: 2 } };
+
+  it('buildStarted stores the turn snapshot from its payload', () => {
+    const state = reducer(
+      initialState,
+      buildStarted({ requestId: 'req_1', turnSnapshot: snapshotA }),
+    );
+    expect(state.turnSnapshot).to.deep.equal(snapshotA);
+    expect(selectTurnSnapshot(root(state))).to.deep.equal(snapshotA);
+  });
+
+  it('buildStarted without a snapshot clears any prior one', () => {
+    let state = reducer(
+      initialState,
+      buildStarted({ requestId: 'req_1', turnSnapshot: snapshotA }),
+    );
+    // The next turn overwrites the snapshot; absent means null so a stale
+    // snapshot never outlives the turn that captured it.
+    state = reducer(state, buildStarted({ requestId: 'req_2' }));
+    expect(state.turnSnapshot).to.eq(null);
+  });
+
+  it('buildStarted overwrites a prior snapshot with a new one', () => {
+    let state = reducer(
+      initialState,
+      buildStarted({ requestId: 'req_1', turnSnapshot: snapshotA }),
+    );
+    state = reducer(
+      state,
+      buildStarted({ requestId: 'req_2', turnSnapshot: snapshotB }),
+    );
+    expect(state.turnSnapshot).to.deep.equal(snapshotB);
+  });
+
+  it('the snapshot survives buildEnded (post-turn revert stays possible)', () => {
+    let state = reducer(
+      initialState,
+      buildStarted({ requestId: 'req_1', turnSnapshot: snapshotA }),
+    );
+    state = reducer(state, buildEnded());
+    expect(state.status).to.eq('idle');
+    // Preserved across the turn boundary so a completed turn can still revert.
+    expect(state.turnSnapshot).to.deep.equal(snapshotA);
+  });
+
+  it('snapshotConsumed clears the snapshot', () => {
+    let state = reducer(
+      initialState,
+      buildStarted({ requestId: 'req_1', turnSnapshot: snapshotA }),
+    );
+    state = reducer(state, snapshotConsumed());
+    expect(state.turnSnapshot).to.eq(null);
+    expect(selectTurnSnapshot(root(state))).to.eq(null);
+  });
+
+  it('buildReverted records the revert timestamp for the announcer', () => {
+    expect(selectLastRevertedAt(root(initialState))).to.eq(null);
+    const state = reducer(initialState, buildReverted(1234));
+    expect(state.lastRevertedAt).to.eq(1234);
+    expect(selectLastRevertedAt(root(state))).to.eq(1234);
+  });
+});
+
+describe('aiBuild smart-lock timing (Phase 3)', () => {
+  it('unlocks after a hop with only a non-structural tool', () => {
+    let state = reducer(initialState, buildStarted({ requestId: 'req_1' }));
+    expect(state.locked).to.eq(true);
+    state = reducer(state, hopReceived({ toolsSelected: ['set_page_value'] }));
+    expect(state.toolsSelected).to.deep.equal(['set_page_value']);
