new file mode 100644
index 0000000..3774f2b
--- /dev/null
+++ b/modules/canvas_ai/src/Plugin/AiFunctionCall/LockViewport.php
@@ -0,0 +1,54 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\canvas_ai\Plugin\AiFunctionCall;
+
+use Drupal\ai\Attribute\FunctionCall;
+use Drupal\ai\Base\FunctionCallBase;
+use Drupal\ai\Service\FunctionCalling\ExecutableFunctionCallInterface;
+use Drupal\ai_agents\PluginInterfaces\AiAgentContextInterface;
+use Drupal\Core\Plugin\Context\ContextDefinition;
+use Drupal\Core\StringTranslation\TranslatableMarkup;
+
+/**
+ * Marker tool that signals a long-running structural build to the editor UI.
+ *
+ * This is a no-op like VerifyTaskCompletion: it changes nothing on the page.
+ * The model is instructed to bundle a lock_viewport call into the first
+ * tool-calling turn of an approved build. The act of selecting it surfaces on
+ * the AiAgentStatusItemTypes::ToolSelected status stream one hop before the
+ * tool executes, and the Canvas editor uses that early signal to keep the
+ * viewport locked for the whole build. NOT a BuilderResponseFunctionCallInterface
+ * — the ToolSelected status stream, not the hop's structured output, is its
+ * transport, so its execute() output never needs to reach the UI.
+ */
+#[FunctionCall(
+  id: 'canvas_ai:lock_viewport',
+  function_name: 'lock_viewport',
+  name: 'Lock Viewport For Build',
+  description: 'Signals that the current request is a long-running structural build (a full page or a bulk change that adds or rearranges several sections), so the editor locks the canvas viewport while you work. Bundle this call into the FIRST tool-calling turn of an approved build, alongside that turn\'s other tool calls. Do NOT call it for questions, advice, or small single edits such as titles, descriptions, or prop tweaks.',
+  group: 'modification_tools',
+  module_dependencies: ['canvas_ai'],
+  context_definitions: [
+    'reason' => new ContextDefinition(
+      data_type: 'string',
+      label: new TranslatableMarkup("Reason"),
+      description: new TranslatableMarkup("Optional short note on why this build is structural, e.g. 'building a full landing page'."),
+      required: FALSE,
+    ),
+  ],
+)]
+final class LockViewport extends FunctionCallBase implements ExecutableFunctionCallInterface, AiAgentContextInterface {
+
+  /**
+   * {@inheritdoc}
+   */
+  public function execute(): void {
+    // No-op: the signal is carried by the ToolSelected status stream, not by
+    // this output. The output only nudges the model to keep building rather
+    // than treating the marker call as a stopping point.
+    $this->setOutput('Viewport locked for this build. Continue with the next build step; remember a text-only turn ends the run.');
+  }
+
+}
diff --git a/modules/canvas_ai/src/Plugin/AiFunctionCall/SetBuildPlan.php b/modules/canvas_ai/src/Plugin/AiFunctionCall/SetBuildPlan.php
new file mode 100644
index 0000000..87be02b
--- /dev/null
+++ b/modules/canvas_ai/src/Plugin/AiFunctionCall/SetBuildPlan.php
@@ -0,0 +1,101 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\canvas_ai\Plugin\AiFunctionCall;
+
+use Drupal\ai\Attribute\FunctionCall;
+use Drupal\ai\Base\FunctionCallBase;
+use Drupal\ai\Service\FunctionCalling\ExecutableFunctionCallInterface;
+use Drupal\ai_agents\PluginInterfaces\AiAgentContextInterface;
+use Drupal\Core\Plugin\Context\ContextDefinition;
+use Drupal\Core\StringTranslation\TranslatableMarkup;
+use Symfony\Component\Yaml\Yaml;
+
+/**
+ * Tool that records the ordered section plan for an approved page build.
+ *
+ * Like PlaceComponents this is a BuilderResponseFunctionCallInterface: its
+ * structured output (`build_plan`) is merged into the hop JSON and reaches the
+ * Canvas editor, which renders one gray skeleton placeholder per planned
+ * section and removes each as the real section lands. Unlike PlaceComponents it
+ * changes nothing on the page — it only declares intent. The model is
+ * instructed to bundle a set_build_plan call into the FIRST tool-calling turn
+ * of an approved build, so the skeleton strip appears before any content.
+ *
+ * @see \Drupal\canvas_ai\Controller\CanvasBuilder::render()
+ * @see \Drupal\canvas_ai\Plugin\AiFunctionCall\PlaceComponents
+ */
+#[FunctionCall(
+  id: 'canvas_ai:set_build_plan',
+  function_name: 'set_build_plan',
+  name: 'Set Build Plan',
+  description: 'Records the ordered plan for an approved page build: every section you intend to place, in order. The input is a YAML list where each item has a "title" (a short human label for the section, e.g. "Hero"), an optional "component_id" (the catalog id you intend to place there, e.g. sdc.byte_theme.section), and an optional "size" ("tall" for content-heavy blocks like heroes, feature grids, stats, FAQs, testimonials, galleries; "short" for slim bands like banners, CTAs, disclaimers, logo strips). Bundle this call into the FIRST tool-calling turn of an approved build, alongside that turn\'s other calls. The editor shows a placeholder per planned section, sized by "size", and removes each one as the real section is placed. Do NOT call it for questions, advice, or small single edits.',
+  group: 'modification_tools',
+  module_dependencies: ['canvas_ai'],
+  context_definitions: [
+    'plan' => new ContextDefinition(
+      data_type: 'string',
+      label: new TranslatableMarkup("Build plan in yml format"),
+      description: new TranslatableMarkup("The ordered sections to build, as a YAML list. Each item is a mapping with a required 'title', an optional 'component_id', and an optional 'size' ('short' or 'tall')."),
+      required: TRUE,
+    ),
+  ],
+)]
+final class SetBuildPlan extends FunctionCallBase implements ExecutableFunctionCallInterface, AiAgentContextInterface, BuilderResponseFunctionCallInterface {
+
+  /**
+   * {@inheritdoc}
+   */
+  public function execute(): void {
+    try {
+      $plan = $this->getContextValue('plan');
+      $sections = Yaml::parse((string) $plan);
+      if (!\is_array($sections) || $sections === [] || !\array_is_list($sections)) {
+        throw new \Exception('The plan must be a non-empty YAML list of sections, each with a title.');
+      }
+
+      // Validate and normalize each section to a fixed {component_id, title}
+      // shape so the frontend never has to guess at optional keys.
+      $normalized = [];
+      foreach ($sections as $index => $section) {
+        if (!\is_array($section) || !isset($section['title']) || !\is_string($section['title']) || \trim($section['title']) === '') {
+          throw new \Exception(\sprintf('Section %d is missing a non-empty string "title".', $index));
+        }
+        $component_id = $section['component_id'] ?? NULL;
+        if ($component_id !== NULL && !\is_string($component_id)) {
+          throw new \Exception(\sprintf('Section %d has a "component_id" that is not a string.', $index));
+        }
+        // Optional card-size hint. Anything but the two known values is treated
+        // as absent (never fails the turn over a cosmetic field); the frontend
+        // falls back to its keyword heuristic when the size is NULL.
+        $size = $section['size'] ?? NULL;
+        if (!\in_array($size, ['short', 'tall'], TRUE)) {
+          $size = NULL;
+        }
+        $normalized[] = [
+          'component_id' => $component_id,
+          'title' => $section['title'],
+          'size' => $size,
+        ];
+      }
+
+      $this->setStructuredOutput(['build_plan' => $normalized]);
+      // The model tends to read a successful tool call as a cue to summarize and
+      // reply. In this stack a turn with no tool call is terminal (see
+      // AiAgentEntityWrapper::determineSolvability()), so that reply would freeze
+      // the build before a single section is placed. Re-assert the continuation
+      // rule on the result itself, mirroring PlaceComponents.
+      $this->setOutput(\sprintf(
+        "Build plan recorded (%d sections). This is a continuation point, not a stopping point: keep building in THIS same response — bundle this call with your other build calls and proceed to place the first section. A turn with text and no tool call would freeze the build here.",
+        \count($normalized),
+      ));
+    }
+    catch (\Exception $e) {
+      // Fail soft: surface the problem as tool output the model can correct on
+      // its next call, without throwing (which would end the turn).
+      $this->setOutput(\sprintf('Failed to record the build plan: %s', $e->getMessage()));
+    }
+  }
+
+}
