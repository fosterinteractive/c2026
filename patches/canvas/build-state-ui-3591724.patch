+import { expect } from '@playwright/test';
+
+import { isolatedPerTest as test } from '../../fixtures/test.js';
+
+// @cspell:ignore canvasai
+/**
+ * Verifies the Phase 1 build-state viewport lock: while an AI turn runs the
+ * viewport is non-interactive, chat and the sidebar stay usable, and the lock
+ * always releases on completion or error.
+ */
+
+test.use({ modules: ['canvas_ai_test'], enableTestExtensions: true });
+
