@@ -0,0 +1,65 @@
+import { selectBuildStatus } from '@/features/aiBuild/aiBuildSlice';
+
+import type { AppStore } from '@/app/store';
+
+/**
+ * Holds the AI build hop loop open while the build is paused.
+ *
+ * Resolves immediately when the build is not paused. While paused it subscribes
+ * to the store and resolves once the status leaves 'paused' (a resume or a
+ * stop). If the passed AbortSignal aborts — or is already aborted — it rejects
+ * with a DOMException named 'AbortError' so the existing hop-loop catch path can
+ * treat it like any other abort. All listeners are removed on settle.
+ *
+ * @param store
+ *   The Redux store driving the build (from useAppStore()/makeStore()).
+ * @param signal
+ *   The in-flight turn's AbortController signal.
+ *
+ * @return
+ *   A promise that resolves when the build is no longer paused, or rejects with
+ *   an AbortError if the signal aborts.
+ */
+export const waitWhilePaused = (
+  store: AppStore,
+  signal: AbortSignal,
+): Promise<void> => {
+  return new Promise<void>((resolve, reject) => {
+    // Already aborted: reject before subscribing to anything.
+    if (signal.aborted) {
+      reject(new DOMException('Aborted', 'AbortError'));
+      return;
+    }
+
+    // Not paused: nothing to wait for, let the hop proceed.
+    if (selectBuildStatus(store.getState()) !== 'paused') {
+      resolve();
+      return;
+    }
+
+    let unsubscribe: (() => void) | null = null;
+
+    const cleanup = () => {
+      signal.removeEventListener('abort', onAbort);
+      if (unsubscribe) {
+        unsubscribe();
+        unsubscribe = null;
+      }
+    };
+
+    const onAbort = () => {
+      cleanup();
+      reject(new DOMException('Aborted', 'AbortError'));
+    };
+
+    const onStoreChange = () => {
+      if (selectBuildStatus(store.getState()) !== 'paused') {
+        cleanup();
+        resolve();
+      }
+    };
+
+    signal.addEventListener('abort', onAbort);
+    unsubscribe = store.subscribe(onStoreChange);
+  });
+};
