+
+describe('aiBuild per-component spotlight (Phase 7)', () => {
+  it('setActiveComponent sets, replaces, and clears the active uuid', () => {
+    let state = reducer(initialState, buildStarted({ requestId: 'req_1' }));
+    expect(state.activeComponentUuid).to.eq(null);
