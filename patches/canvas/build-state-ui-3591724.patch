+import {
+  computeFollowScrollTop,
+  FOLLOW_ANCHOR_RATIO,
+  isNearTarget,
+  stepTowards,
+} from '@/features/aiBuild/followScroll';
+
+describe('computeFollowScrollTop', () => {
+  it('anchors the target top at 15% of the pane height by default', () => {
+    // Pane 1000 tall, target top at 800 in the scroll content. The default 15%
+    // anchor parks the target top 0.15 * 1000 = 150 below the pane top, so the
+    // scrollTop is 800 - 150 = 650.
+    expect(FOLLOW_ANCHOR_RATIO).to.eq(0.15);
+    expect(
+      computeFollowScrollTop({
+        paneScrollTop: 0,
+        paneClientHeight: 1000,
+        targetTopInPane: 800,
+      }),
+    ).to.eq(650);
+  });
+
+  it('is invariant to the current paneScrollTop', () => {
+    // The anchored scrollTop is absolute, so the pane's current scroll offset
+    // does not change the result.
+    const args = {
+      paneClientHeight: 1000,
+      targetTopInPane: 800,
+    };
+    expect(computeFollowScrollTop({ ...args, paneScrollTop: 0 })).to.eq(
+      computeFollowScrollTop({ ...args, paneScrollTop: 5000 }),
+    );
+  });
+
+  it('honors a custom anchorRatio', () => {
+    // A 25% anchor parks the target top 0.25 * 1000 = 250 below the pane top.
+    expect(
+      computeFollowScrollTop({
+        paneScrollTop: 0,
+        paneClientHeight: 1000,
+        targetTopInPane: 800,
+        anchorRatio: 0.25,
+      }),
+    ).to.eq(550);
+  });
+
+  it('does not depend on target height (top-anchor, not centered)', () => {
+    // Height is no longer part of the math; a tall and a short target at the
+    // same top anchor to the same scrollTop.
+    const args = {
+      paneScrollTop: 0,
+      paneClientHeight: 1000,
+      targetTopInPane: 800,
+    };
+    expect(computeFollowScrollTop(args)).to.eq(650);
+  });
+
+  it('clamps a negative anchored position to 0', () => {
+    // A target near the very top would anchor at a negative scrollTop; clamp it.
+    expect(
+      computeFollowScrollTop({
+        paneScrollTop: 0,
+        paneClientHeight: 1000,
+        targetTopInPane: 100,
+      }),
+    ).to.eq(0);
+  });
+
+  it('clamps to maxScrollTop when it is supplied', () => {
+    // Anchored position 650 exceeds a max scroll of 500, so it is capped at 500
+    // (writing an unreachable scrollTop would leave the loop unable to settle).
+    expect(
+      computeFollowScrollTop({
+        paneScrollTop: 0,
+        paneClientHeight: 1000,
+        targetTopInPane: 800,
+        maxScrollTop: 500,
+      }),
+    ).to.eq(500);
+  });
+
+  it('treats a negative maxScrollTop (content shorter than pane) as 0', () => {
+    expect(
+      computeFollowScrollTop({
+        paneScrollTop: 0,
+        paneClientHeight: 1000,
+        targetTopInPane: 800,
+        maxScrollTop: -300,
+      }),
+    ).to.eq(0);
+  });
+
+  it('applies no upper clamp when maxScrollTop is omitted', () => {
+    expect(
+      computeFollowScrollTop({
+        paneScrollTop: 0,
+        paneClientHeight: 1000,
+        targetTopInPane: 100000,
+      }),
+    ).to.eq(100000 - 150);
+  });
+});
+
+describe('isNearTarget', () => {
+  it('is true when the pane sits exactly on the desired position', () => {
+    expect(
+      isNearTarget({
+        paneScrollTop: 400,
+        desiredScrollTop: 400,
+        threshold: 150,
+      }),
+    ).to.eq(true);
+  });
+
+  it('is true at exactly the threshold distance (inclusive)', () => {
+    expect(
+      isNearTarget({
+        paneScrollTop: 550,
+        desiredScrollTop: 400,
+        threshold: 150,
+      }),
+    ).to.eq(true);
+    // Symmetric below the target as well.
+    expect(
+      isNearTarget({
+        paneScrollTop: 250,
+        desiredScrollTop: 400,
+        threshold: 150,
+      }),
+    ).to.eq(true);
+  });
+
+  it('is false just past the threshold distance', () => {
+    expect(
+      isNearTarget({
+        paneScrollTop: 551,
+        desiredScrollTop: 400,
+        threshold: 150,
+      }),
+    ).to.eq(false);
+  });
+});
+
+describe('stepTowards', () => {
+  // The component's tuning constants, mirrored so the duration assertion below
+  // tracks the real motion.
+  const MAX_VELOCITY_PX_S = 2200;
+  const EASE_FACTOR = 12;
+  const TICK_MS = 16;
+
+  // Run the animation to completion and return the position samples plus the
+  // number of ticks taken. Guards against an infinite loop with a hard cap.
+  const runToDone = ({
+    from,
+    to,
+    dtMs = TICK_MS,
+    maxVelocityPxS = MAX_VELOCITY_PX_S,
+    easeFactor = EASE_FACTOR,
+    maxTicks = 5000,
+  }) => {
+    const samples = [from];
+    let current = from;
+    let ticks = 0;
+    for (; ticks < maxTicks; ticks += 1) {
+      const { next, done } = stepTowards({
+        current,
+        target: to,
+        dtMs,
+        maxVelocityPxS,
+        easeFactor,
+      });
+      current = next;
+      samples.push(current);
+      if (done) {
+        ticks += 1;
+        break;
+      }
+    }
+    return { samples, ticks };
+  };
+
+  it('reports done immediately when already within a sub-pixel of target', () => {
+    const { next, done } = stepTowards({
+      current: 100.4,
+      target: 100,
+      dtMs: TICK_MS,
+      maxVelocityPxS: MAX_VELOCITY_PX_S,
+      easeFactor: EASE_FACTOR,
+    });
+    expect(done).to.eq(true);
+    expect(next).to.eq(100);
+  });
+
+  it('does not move on zero dt and is not done', () => {
+    const { next, done } = stepTowards({
+      current: 0,
+      target: 900,
+      dtMs: 0,
+      maxVelocityPxS: MAX_VELOCITY_PX_S,
+      easeFactor: EASE_FACTOR,
+    });
+    expect(next).to.eq(0);
+    expect(done).to.eq(false);
+  });
+
+  it('treats a negative dt as zero (no movement, not done)', () => {
+    const { next, done } = stepTowards({
+      current: 0,
+      target: 900,
+      dtMs: -50,
+      maxVelocityPxS: MAX_VELOCITY_PX_S,
+      easeFactor: EASE_FACTOR,
+    });
+    expect(next).to.eq(0);
+    expect(done).to.eq(false);
+  });
+
+  it('caps a far step at maxVelocity * dt', () => {
+    // 10000px away: the eased term (12 * 10000 * 0.016 = 1920) is huge, so the
+    // velocity cap governs. Cap = 2200 * 0.016 = 35.2.
+    const { next, done } = stepTowards({
+      current: 0,
+      target: 10000,
+      dtMs: TICK_MS,
+      maxVelocityPxS: MAX_VELOCITY_PX_S,
+      easeFactor: EASE_FACTOR,
+    });
+    expect(next).to.be.closeTo(35.2, 1e-9);
+    expect(done).to.eq(false);
+  });
+
+  it('eases (below the cap) once inside the crossover distance', () => {
+    // 100px away (< 2200/12 ≈ 183 crossover): eased step = 12 * 100 * 0.016 =
+    // 19.2, which is under the 35.2 velocity cap.
+    const { next } = stepTowards({
+      current: 0,
+      target: 100,
+      dtMs: TICK_MS,
+      maxVelocityPxS: MAX_VELOCITY_PX_S,
+      easeFactor: EASE_FACTOR,
+    });
+    expect(next).to.be.closeTo(19.2, 1e-9);
+    // Confirm it is genuinely below the velocity cap of 35.2.
+    expect(next).to.be.lessThan(35.2);
+  });
+
+  it('never overshoots the target, even with a huge dt', () => {
+    // 5px away with a 1s dt: the eased term (12 * 5 * 1 = 60) and the cap
+    // (2200 * 1 = 2200) both exceed the 5px remaining, so the step is clamped to
+    // the remaining distance and snaps exactly onto target.
+    const { next, done } = stepTowards({
+      current: 0,
+      target: 5,
+      dtMs: 1000,
+      maxVelocityPxS: MAX_VELOCITY_PX_S,
+      easeFactor: EASE_FACTOR,
+    });
+    expect(next).to.eq(5);
+    expect(done).to.eq(true);
+  });
+
+  it('snaps exactly onto the target on the terminal step', () => {
+    // 1px away: eased step 0.192 lands at 0.192 short of a sub-pixel, so it snaps.
+    const { next, done } = stepTowards({
+      current: 99,
+      target: 100,
+      dtMs: TICK_MS,
+      maxVelocityPxS: MAX_VELOCITY_PX_S,
+      easeFactor: EASE_FACTOR,
+    });
+    expect(next).to.eq(100);
+    expect(done).to.eq(true);
+  });
+
+  it('approaches an upward target monotonically and settles exactly on it', () => {
+    const { samples } = runToDone({ from: 0, to: 900 });
+    for (let i = 1; i < samples.length; i += 1) {
+      // Never moves backward and never overshoots the target.
+      expect(samples[i]).to.be.at.least(samples[i - 1]);
+      expect(samples[i]).to.be.at.most(900);
+    }
+    expect(samples[samples.length - 1]).to.eq(900);
+  });
+
+  it('approaches a downward target monotonically and settles exactly on it', () => {
+    const { samples } = runToDone({ from: 1000, to: 0 });
+    for (let i = 1; i < samples.length; i += 1) {
+      // Never moves backward (upward) and never overshoots below the target.
+      expect(samples[i]).to.be.at.most(samples[i - 1]);
+      expect(samples[i]).to.be.at.least(0);
+    }
+    expect(samples[samples.length - 1]).to.eq(0);
+  });
+
+  it('respects the velocity cap on every tick of a full run', () => {
+    const cap = MAX_VELOCITY_PX_S * (TICK_MS / 1000); // 35.2 px/tick
+    const { samples } = runToDone({ from: 0, to: 900 });
+    for (let i = 1; i < samples.length; i += 1) {
+      const step = Math.abs(samples[i] - samples[i - 1]);
+      // Allow a hair of floating-point slack above the exact cap.
+      expect(step).to.be.at.most(cap + 1e-9);
+    }
+  });
+
+  it('pans a full pane-height (~900px) within the 600-900ms band', () => {
+    const { ticks } = runToDone({ from: 0, to: 900 });
+    const durationMs = ticks * TICK_MS;
+    expect(durationMs).to.be.at.least(600);
+    expect(durationMs).to.be.at.most(900);
+  });
+
+  it('always terminates for a very large jump (velocity-limited pan)', () => {
+    // A 5700px jump (the measured native-scroll distance) still converges; it is
+    // just bounded by the velocity cap rather than teleporting.
+    const { ticks, samples } = runToDone({ from: 0, to: 5700 });
+    expect(samples[samples.length - 1]).to.eq(5700);
+    // 5700 / 35.2 ≈ 162 capped ticks + a short eased tail; comfortably finite.
+    expect(ticks).to.be.lessThan(400);
+  });
+
+  it('a late (throttled) tick moves proportionally further than a normal tick', () => {
+    // Same distance, 10x the dt while still velocity-capped: 10x the step. This
+    // is what keeps an occluded, throttled loop time-correct.
+    const base = stepTowards({
+      current: 0,
+      target: 10000,
+      dtMs: 16,
+      maxVelocityPxS: MAX_VELOCITY_PX_S,
+      easeFactor: EASE_FACTOR,
+    });
+    const late = stepTowards({
+      current: 0,
+      target: 10000,
+      dtMs: 160,
+      maxVelocityPxS: MAX_VELOCITY_PX_S,
+      easeFactor: EASE_FACTOR,
+    });
+    expect(late.next).to.be.closeTo(base.next * 10, 1e-6);
+  });
+});
diff --git a/ui/tests/vitest/unit/revert-build.test.js b/ui/tests/vitest/unit/revert-build.test.js
new file mode 100644
index 0000000..5195940
--- /dev/null
+++ b/ui/tests/vitest/unit/revert-build.test.js
@@ -0,0 +1,265 @@
+import { makeStore } from '@/app/store';
+import {
+  buildPaused,
+  buildStarted,
+  selectTurnSnapshot,
+} from '@/features/aiBuild/aiBuildSlice';
+import {
+  abortActiveBuild,
+  isActiveBuildAborted,
+  setActiveBuildAbort,
+} from '@/features/aiBuild/buildAbortRegistry';
+import { revertBuildTurn } from '@/features/aiBuild/revertBuildTurn';
+import {
+  initialState,
+  insertNodes,
+  selectLayout,
+  selectModel,
+} from '@/features/layout/layoutModelSlice';
+import {
+  selectUndoItem,
+  initialState as uiInitialState,
+  UndoRedoActionCreators,
+} from '@/features/ui/uiSlice';
+
+// A route is required so the undo middleware can snapshot it on each layoutModel
+// action.
+const route = {
+  pathname: '/editor/canvas_page/1',
+  search: '',
+  hash: '',
+};
+
+// A one-component pre-turn layout. A non-empty model lets the redux-undo filter
+// record the layoutModel actions that follow.
+const seededLayout = () => ({
+  updatePreview: false,
+  layout: [
+    {
+      nodeType: 'region',
+      components: [
+        {
+          nodeType: 'component',
+          uuid: 'seed-card',
+          type: 'sdc_test:my-cta',
+          slots: [],
+        },
+      ],
+      id: 'content',
+      name: 'Content',
+    },
+  ],
+  model: {
+    'seed-card': {
+      text: 'hello, world!',
+      href: 'https://drupal.org',
+      name: 'Seed CTA',
+    },
+  },
+});
+
+// A distinct component the "AI build" places during the turn.
+const placedNode = (uuid, type) => ({
+  layout: [{ slots: [], nodeType: 'component', type, uuid }],
+  model: { [uuid]: { title: `Component ${uuid}` } },
+});
+
+// Builds a store preloaded with the seeded layout and a usable ui slice.
+const makeSeededStore = () =>
+  makeStore({
+    layoutModel: { present: seededLayout(), past: [initialState], future: [] },
+    ui: { ...uiInitialState, currentRoute: route },
+  });
+
+// Captures the current layoutModel present references as a turn snapshot, the
+// same shape AiWizard passes to buildStarted.
+const captureSnapshot = (store) => ({
+  layout: selectLayout(store.getState()),
+  model: selectModel(store.getState()),
+});
+
+describe('revertBuildTurn (Phase 5 milestone revert)', () => {
+  it('restores the pre-turn layout in exactly one undo entry, and one Ctrl-Z brings the build back', () => {
+    const store = makeSeededStore();
+    const snapshot = captureSnapshot(store);
+
+    store.dispatch(
+      buildStarted({ requestId: 'req_1', turnSnapshot: snapshot }),
+    );
+
+    // The "AI" places two components across the turn (mirrors placements landing
+    // in the layoutModel slice).
+    store.dispatch(
+      insertNodes({
+        to: [0, 1],
+        layoutModel: placedNode('abc1234', 'some.block'),
+        useUUID: 'abc1234',
+      }),
+    );
+    store.dispatch(
+      insertNodes({
+        to: [0, 2],
+        layoutModel: placedNode('def5678', 'some.other_block'),
+        useUUID: 'def5678',
+      }),
+    );
+
+    // The post-build layout has the seed plus the two placed components.
+    const postBuildModelKeys = Object.keys(selectModel(store.getState()));
+    expect(postBuildModelKeys).to.deep.equal([
+      'seed-card',
+      'abc1234',
+      'def5678',
+    ]);
+
+    // The revert dispatch must add exactly one undo entry (a single Ctrl-Z step).
+    const undoStackBefore = store.getState().ui.undoStack.length;
+    store.dispatch(revertBuildTurn());
+    const undoStackAfter = store.getState().ui.undoStack.length;
+    expect(undoStackAfter - undoStackBefore).to.eq(1);
+
+    // The layout is back to the pre-turn snapshot, and the snapshot is consumed.
+    expect(selectLayout(store.getState())).to.deep.equal(snapshot.layout);
+    expect(selectModel(store.getState())).to.deep.equal(snapshot.model);
+    expect(selectTurnSnapshot(store.getState())).to.eq(null);
+    expect(store.getState().aiBuild.status).to.eq('idle');
+
+    // A single native undo restores the whole build in one step (and is
+    // redo-able, since it is a normal undoable action).
+    const undoItem = selectUndoItem(store.getState());
+    expect(undoItem?.targetSlice).to.eq('layoutModel');
+    store.dispatch(UndoRedoActionCreators.undo(undoItem?.targetSlice));
+    expect(Object.keys(selectModel(store.getState()))).to.deep.equal(
+      postBuildModelKeys,
+    );
+  });
+
+  it('is idempotent: a second press with the snapshot consumed makes no layoutModel dispatch', () => {
+    const store = makeSeededStore();
+    const snapshot = captureSnapshot(store);
+    store.dispatch(
+      buildStarted({ requestId: 'req_1', turnSnapshot: snapshot }),
+    );
+    store.dispatch(
+      insertNodes({
+        to: [0, 1],
+        layoutModel: placedNode('abc1234', 'some.block'),
+        useUUID: 'abc1234',
+      }),
+    );
+
+    // First press restores and consumes the snapshot (one undo entry).
+    store.dispatch(revertBuildTurn());
+    expect(selectTurnSnapshot(store.getState())).to.eq(null);
+    const undoStackAfterFirst = store.getState().ui.undoStack.length;
+
+    // Second press: no snapshot, so no layoutModel dispatch and no new undo
+    // entry.
+    store.dispatch(revertBuildTurn());
+    expect(store.getState().ui.undoStack.length).to.eq(undoStackAfterFirst);
+    expect(store.getState().aiBuild.status).to.eq('idle');
+  });
+
+  it('makes no layoutModel dispatch when the turn changed nothing', () => {
+    const store = makeSeededStore();
+    const snapshot = captureSnapshot(store);
+    store.dispatch(
+      buildStarted({ requestId: 'req_1', turnSnapshot: snapshot }),
+    );
+
+    // No placements this turn: the layout reference is unchanged, so the revert
+    // must not push an empty undo entry.
+    const undoStackBefore = store.getState().ui.undoStack.length;
+    store.dispatch(revertBuildTurn());
+    expect(store.getState().ui.undoStack.length).to.eq(undoStackBefore);
+    // The build still ends and the snapshot is consumed.
+    expect(store.getState().aiBuild.status).to.eq('idle');
+    expect(selectTurnSnapshot(store.getState())).to.eq(null);
+  });
+
+  it('reverts while paused and aborts the in-flight build', () => {
+    const store = makeSeededStore();
+    const snapshot = captureSnapshot(store);
+    store.dispatch(
+      buildStarted({ requestId: 'req_1', turnSnapshot: snapshot }),
+    );
+
+    // Register an abort controller as the hop loop would, then pause.
+    const controller = new AbortController();
+    setActiveBuildAbort(controller);
+    store.dispatch(
+      insertNodes({
+        to: [0, 1],
+        layoutModel: placedNode('abc1234', 'some.block'),
+        useUUID: 'abc1234',
+      }),
+    );
+    store.dispatch(buildPaused());
+    expect(store.getState().aiBuild.status).to.eq('paused');
+
+    store.dispatch(revertBuildTurn());
+
+    // The in-flight build was aborted and the layout restored from the snapshot.
+    expect(controller.signal.aborted).to.eq(true);
+    expect(selectLayout(store.getState())).to.deep.equal(snapshot.layout);
+    expect(selectModel(store.getState())).to.deep.equal(snapshot.model);
+    expect(store.getState().aiBuild.status).to.eq('idle');
+
+    // Clean up the module-scope registry for other tests.
+    setActiveBuildAbort(null);
+  });
+});
+
+// Guards for the revert vs in-flight application race: a hop's operations are
+// applied one at a time by handlers in AiWizard, which check
+// isActiveBuildAborted() before each mutation. The full timing race lives
+// inside the AiWizard component closure and cannot be driven from a unit test;
+// these cover the registry states the handler guard reads. The race itself is
+// validated live with an interceptor-timed revert click.
+describe('isActiveBuildAborted (handler guard states)', () => {
+  afterEach(() => {
+    // Never leak a module-scope registration into other tests.
+    setActiveBuildAbort(null);
+  });
+
+  it('is false with no registered controller', () => {
+    setActiveBuildAbort(null);
+    expect(isActiveBuildAborted()).to.eq(false);
+    // Aborting with nothing registered reports false and stays un-aborted.
+    expect(abortActiveBuild()).to.eq(false);
+    expect(isActiveBuildAborted()).to.eq(false);
+  });
+
+  it('is false while the registered build runs un-aborted', () => {
+    setActiveBuildAbort(new AbortController());
+    expect(isActiveBuildAborted()).to.eq(false);
+  });
+
+  it('turns true on abort and keeps the controller registered until cleared', () => {
+    const controller = new AbortController();
+    setActiveBuildAbort(controller);
+    expect(abortActiveBuild()).to.eq(true);
+    expect(controller.signal.aborted).to.eq(true);
+    // The registration survives the abort (the hop loop's .finally clears it),
+    // so an in-flight application loop can observe the aborted state.
+    expect(isActiveBuildAborted()).to.eq(true);
+    // Once the hop loop clears the registry the guard reads false again.
+    setActiveBuildAbort(null);
+    expect(isActiveBuildAborted()).to.eq(false);
+  });
+
+  it('reads true after revertBuildTurn aborts a registered build', () => {
+    const store = makeSeededStore();
+    const snapshot = captureSnapshot(store);
+    store.dispatch(
+      buildStarted({ requestId: 'req_1', turnSnapshot: snapshot }),
+    );
+    setActiveBuildAbort(new AbortController());
+
+    store.dispatch(revertBuildTurn());
+
+    // This is the state the operations/edit loops see mid-application after a
+    // revert click: aborted but still registered.
+    expect(isActiveBuildAborted()).to.eq(true);
+  });
+});
diff --git a/ui/tests/vitest/unit/wait-while-paused.test.js b/ui/tests/vitest/unit/wait-while-paused.test.js
new file mode 100644
index 0000000..ba04aa3
--- /dev/null
+++ b/ui/tests/vitest/unit/wait-while-paused.test.js
@@ -0,0 +1,82 @@
+import { makeStore } from '@/app/store';
+import {
+  buildPaused,
+  buildResumed,
+  buildStarted,
+} from '@/features/aiBuild/aiBuildSlice';
+import { waitWhilePaused } from '@/features/aiBuild/waitWhilePaused';
+
+// Flushes the microtask queue so a still-pending gate can be observed without
+// resolving it (no dispatch happens, so a paused gate must stay pending).
+const flushMicrotasks = () => Promise.resolve();
+
+describe('waitWhilePaused', () => {
+  it('resolves immediately when the build is not paused', async () => {
+    const store = makeStore();
+    store.dispatch(buildStarted({ requestId: 'req_1' }));
+    const controller = new AbortController();
+
+    let settled = false;
+    await waitWhilePaused(store, controller.signal).then(() => {
+      settled = true;
+    });
+    expect(settled).to.eq(true);
+  });
+
+  it('stays pending while paused and resolves after buildResumed', async () => {
+    const store = makeStore();
+    store.dispatch(buildStarted({ requestId: 'req_1' }));
+    store.dispatch(buildPaused());
+    const controller = new AbortController();
+
+    let settled = false;
+    const gate = waitWhilePaused(store, controller.signal).then(() => {
+      settled = true;
+    });
+
+    // The gate must not resolve while the build is still paused.
+    await flushMicrotasks();
+    expect(settled).to.eq(false);
+
+    // Resuming leaves the 'paused' status, so the gate resolves.
+    store.dispatch(buildResumed());
+    await gate;
+    expect(settled).to.eq(true);
+  });
+
+  it('rejects with an AbortError when the signal aborts while paused', async () => {
+    const store = makeStore();
+    store.dispatch(buildStarted({ requestId: 'req_1' }));
+    store.dispatch(buildPaused());
+    const controller = new AbortController();
+
+    const gate = waitWhilePaused(store, controller.signal);
+    controller.abort();
+
+    let error;
+    try {
+      await gate;
+    } catch (caught) {
+      error = caught;
+    }
+    expect(error).to.be.instanceOf(DOMException);
+    expect(error.name).to.eq('AbortError');
+  });
+
+  it('rejects immediately if the signal is already aborted', async () => {
+    const store = makeStore();
+    store.dispatch(buildStarted({ requestId: 'req_1' }));
+    store.dispatch(buildPaused());
+    const controller = new AbortController();
+    controller.abort();
+
+    let error;
+    try {
+      await waitWhilePaused(store, controller.signal);
+    } catch (caught) {
+      error = caught;
+    }
+    expect(error).to.be.instanceOf(DOMException);
+    expect(error.name).to.eq('AbortError');
+  });
+});
