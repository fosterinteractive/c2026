+    // Status is building, but the flag being off keeps the glow off.
+    expect(mod.selectBuildStatus({ aiBuild: building })).to.eq('building');
+    expect(mod.selectIsGlowing({ aiBuild: building })).to.eq(false);
+    vi.doUnmock('@/utils/drupal-globals');
