+    // Before any component lands, the whole-viewport glow (Phase 2) is showing.
+    await expect(container).toHaveAttribute('data-canvas-glowing', 'true');
+
+    // hop2 places the first section; once its DOM renders in the preview the
+    // per-component spotlight resolves a rect and its glow appears. Exactly one
+    // component is active at a time, so exactly one glow element exists.
+    // Generous timeouts absorb the isolated-site preview-refresh timing.
+    await expect(spotlight).toBeVisible({ timeout: 15000 });
+    await expect(spotlight).toHaveCount(1);
+
+    // The whole-viewport glow is suppressed while a component is spotlighted —
+    // the two glows are never doubled.
+    await expect(container).not.toHaveAttribute('data-canvas-glowing', 'true');
+
+    // On completion the build ends, clearing the active component: both the
+    // per-component spotlight and the whole-viewport glow are gone.
+    await expect(
+      page.getByText('I built a planned page with two sections.'),
+    ).toBeVisible();
+    await expect(spotlight).toHaveCount(0);
+    await expect(container).toHaveAttribute('data-canvas-glowing', 'false');
+  });
+
+  test('build error clears remaining skeletons', async ({
+    page,
+    drupal,
+    canvas,
+    ai,
+  }) => {
+    await drupal.login({ username: 'ai_editor', password: 'ai_editor' });
+    await canvas.createCanvas();
+    await ai.openPanel();
+
+    await ai.submitQuery('Build me a failing planned page');
+
+    // hop1 declares the plan, so two skeletons appear.
+    const skeletons = page.getByTestId('canvas-plan-skeleton');
+    await expect(skeletons).toHaveCount(2);
+
+    // hop2 returns status:false; the error surfaces and the build ends, so the
+    // remaining skeletons vanish.
+    await expect(
+      page.getByText('Simulated planned-build failure'),
+    ).toBeVisible();
+    await expect(skeletons).toHaveCount(0);
+  });
+});
