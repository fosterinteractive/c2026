@@ -0,0 +1,59 @@
+import { useEffect } from 'react';
+import clsx from 'clsx';
+
+import { useAppSelector } from '@/app/hooks';
+import { selectIsCanvasLocked } from '@/features/aiBuild/aiBuildSlice';
+import { BUILD_LOCK_OVERLAY_TESTID } from '@/features/aiBuild/constants';
+
+import styles from './BuildLockOverlay.module.css';
+
+interface BuildLockOverlayProps {
+  // When true, paint the 20% blue lock tint so the locked, non-clickable canvas
+  // reads as inert. Suppressed (false) while the per-component spotlight scrim is
+  // already tinting the rest of the viewport, so the two never double-stack. The
+  // pointer-catching behavior is unaffected either way.
+  tinted?: boolean;
+}
+
+/**
+ * Pointer-catching overlay shown over the viewport while the AI builds the page.
+ * It blocks interaction with the (interactive-mode) preview iframe; the component
+ * overlays in edit mode are neutralized separately. While `tinted`, it also
+ * paints a 20% blue wash so the locked state is visible; the tint fades in and
+ * out via a CSS transition.
+ */
+const BuildLockOverlay = ({ tinted = true }: BuildLockOverlayProps) => {
+  const isLocked = useAppSelector(selectIsCanvasLocked);
+
+  useEffect(() => {
+    if (!isLocked) {
+      return;
+    }
+    // When the lock engages, move focus out of the canvas so keyboard input
+    // cannot reach the neutralized component overlays, then best-effort hand
+    // focus to the chat so the user can keep typing.
+    const active = document.activeElement as HTMLElement | null;
+    const overlayRoot = document.getElementById('canvasPreviewOverlay');
+    if (active && overlayRoot?.contains(active)) {
+      active.blur();
+      const deepChat = document.querySelector(
+        'deep-chat',
+      ) as HTMLElement | null;
+      deepChat?.focus?.();
+    }
+  }, [isLocked]);
+
+  if (!isLocked) {
+    return null;
+  }
+
+  return (
+    <div
+      className={clsx(styles.overlay, { [styles.tinted]: tinted })}
+      data-testid={BUILD_LOCK_OVERLAY_TESTID}
+      aria-hidden="true"
+    />
+  );
+};
+
+export default BuildLockOverlay;
diff --git a/ui/src/features/aiBuild/BuildPanel.module.css b/ui/src/features/aiBuild/BuildPanel.module.css
