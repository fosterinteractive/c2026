+});
+
+describe('aiBuild plan skeletons (Phase 6)', () => {
+  const plan = [
+    { componentId: 'sdc.a.hero', title: 'Hero' },
+    { componentId: 'sdc.a.features', title: 'Features' },
+  ];
+  // What planReceived stores for `plan`: no explicit sizes, and both titles hit
+  // the tall-keyword heuristic (hero, feature), so both cards come out tall.
+  const storedPlan = [
+    { componentId: 'sdc.a.hero', title: 'Hero', size: 'tall' },
+    { componentId: 'sdc.a.features', title: 'Features', size: 'tall' },
+  ];
+
+  it('planReceived stores the ordered list and resets placedCount', () => {
+    let state = reducer(initialState, buildStarted({ requestId: 'req_1' }));
+    // A stray placement before the plan arrives leaves placedCount at 0.
+    state = reducer(state, componentPlaced({ componentId: 'x' }));
+    expect(state.placedCount).to.eq(0);
+    state = reducer(state, planReceived(plan));
+    expect(state.plannedComponents).to.deep.equal(storedPlan);
+    expect(selectPlannedComponents(root(state))).to.deep.equal(storedPlan);
+    expect(state.placedCount).to.eq(0);
+  });
+
+  it('planReceived normalizes a missing componentId to null', () => {
+    let state = reducer(initialState, buildStarted({ requestId: 'req_1' }));
+    state = reducer(state, planReceived([{ title: 'Hero' }]));
+    expect(state.plannedComponents).to.deep.equal([
+      { componentId: null, title: 'Hero', size: 'tall' },
+    ]);
+  });
+
+  it('planReceived respects an explicit valid size over the heuristic', () => {
+    let state = reducer(initialState, buildStarted({ requestId: 'req_1' }));
+    // 'Hero' would be tall by keyword; the agent's explicit 'short' wins. The
+    // inverse holds for a non-keyword title declared 'tall'.
+    state = reducer(
+      state,
+      planReceived([
+        { componentId: 'sdc.a.hero', title: 'Hero', size: 'short' },
+        { componentId: 'sdc.a.intro', title: 'Intro', size: 'tall' },
+      ]),
+    );
+    expect(state.plannedComponents[0].size).to.eq('short');
+    expect(state.plannedComponents[1].size).to.eq('tall');
+  });
+
+  it('planReceived falls back to the heuristic on an invalid size', () => {
+    let state = reducer(initialState, buildStarted({ requestId: 'req_1' }));
+    state = reducer(
+      state,
+      planReceived([
+        // Invalid enum value + tall keyword in the title → tall.
+        { componentId: null, title: 'Hero', size: 'huge' },
+        // Invalid enum value + no tall keyword anywhere → short.
+        { componentId: 'sdc.a.banner', title: 'Banner', size: 'medium' },
+      ]),
+    );
+    expect(state.plannedComponents[0].size).to.eq('tall');
+    expect(state.plannedComponents[1].size).to.eq('short');
+  });
+
+  it('the size heuristic reads the componentId as well as the title', () => {
+    let state = reducer(initialState, buildStarted({ requestId: 'req_1' }));
+    state = reducer(
+      state,
+      planReceived([
+        // Neutral title; the tall keyword lives in the component id.
+        { componentId: 'sdc.theme.stats_band', title: 'Numbers' },
+        // No tall keyword in either field → short.
+        { componentId: 'sdc.theme.cta_band', title: 'Sign up' },
+      ]),
+    );
+    expect(state.plannedComponents[0].size).to.eq('tall');
+    expect(state.plannedComponents[1].size).to.eq('short');
+  });
+
+  it('a later planReceived resets placedCount for the new plan', () => {
+    let state = reducer(initialState, buildStarted({ requestId: 'req_1' }));
+    state = reducer(state, planReceived(plan));
+    state = reducer(state, componentPlaced({ componentId: 'sdc.a.hero' }));
+    expect(selectPlacedCount(root(state))).to.eq(1);
+    state = reducer(state, planReceived(plan));
+    expect(state.placedCount).to.eq(0);
+  });
+
+  it('componentPlaced advances placedCount even on an id mismatch', () => {
+    let state = reducer(initialState, buildStarted({ requestId: 'req_1' }));
+    state = reducer(state, planReceived(plan));
+    // The placed id does not match plannedComponents[0].componentId; still advance.
+    state = reducer(
+      state,
+      componentPlaced({ componentId: 'sdc.z.unexpected' }),
+    );
+    expect(state.placedCount).to.eq(1);
+    state = reducer(state, componentPlaced({ componentId: 'sdc.a.features' }));
+    expect(state.placedCount).to.eq(2);
+  });
+
+  it('componentPlaced never advances past the plan length', () => {
+    let state = reducer(initialState, buildStarted({ requestId: 'req_1' }));
+    state = reducer(state, planReceived(plan));
+    state = reducer(state, componentPlaced({ componentId: 'a' }));
+    state = reducer(state, componentPlaced({ componentId: 'b' }));
+    state = reducer(state, componentPlaced({ componentId: 'c' }));
+    expect(state.placedCount).to.eq(2);
