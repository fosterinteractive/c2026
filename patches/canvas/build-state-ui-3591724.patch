index 0000000..0128921
--- /dev/null
+++ b/ui/src/features/aiBuild/followScroll.ts
@@ -0,0 +1,142 @@
+/**
+ * Pure scroll math for the Phase 8 "Follow Edits" auto-scroller. No DOM access:
+ * the caller measures the pane and target with getBoundingClientRect and passes
+ * plain numbers here so the geometry is unit-testable in isolation.
+ */
+
+// Fraction of the pane height, measured from the pane's visible top, at which
+// the top of the worked-on region is parked. Round 2 replaced vertical centering
+// with this top-anchor so the region being edited sits high in the viewport,
+// leaving room below for the content the AI is about to add.
+export const FOLLOW_ANCHOR_RATIO = 0.15;
+
+interface ComputeFollowScrollTopArgs {
+  // Current scroll offset of the pane. Present for call-site symmetry with
+  // isNearTarget; the anchored scrollTop is scroll-invariant so it is not read.
+  paneScrollTop: number;
+  // The pane's visible height (its clientHeight).
+  paneClientHeight: number;
+  // The target's top within the pane's scroll-content coordinate space (scaled).
+  targetTopInPane: number;
+  // Fraction of paneClientHeight, from the pane top, at which to park the target
+  // top. Defaults to FOLLOW_ANCHOR_RATIO (0.15).
+  anchorRatio?: number;
+  // Optional upper clamp: the pane's maximum scrollTop
+  // (scrollHeight - clientHeight). When supplied, the result never exceeds it so
+  // the animator's target is always actually reachable and the loop can settle
+  // (writing an unreachable target would leave the browser-clamped scrollTop
+  // short of it forever). Omit to leave the upper bound to the caller.
+  maxScrollTop?: number;
+}
+
+/**
+ * The scrollTop that parks the target's top at `anchorRatio` of the pane height
+ * from the pane's visible top (15% by default).
+ *
+ * Clamped to >= 0 so we never request a negative scroll, and to <= maxScrollTop
+ * when the caller supplies the pane's maximum scroll offset.
+ */
+export const computeFollowScrollTop = ({
+  paneClientHeight,
+  targetTopInPane,
+  anchorRatio = FOLLOW_ANCHOR_RATIO,
+  maxScrollTop,
+}: ComputeFollowScrollTopArgs): number => {
+  const desired = targetTopInPane - anchorRatio * paneClientHeight;
+  const lowerClamped = Math.max(0, desired);
+  if (maxScrollTop === undefined) {
+    return lowerClamped;
+  }
+  return Math.min(lowerClamped, Math.max(0, maxScrollTop));
+};
+
+interface IsNearTargetArgs {
+  // Current scroll offset of the pane.
+  paneScrollTop: number;
+  // The scrollTop that would anchor the target (from computeFollowScrollTop).
+  desiredScrollTop: number;
+  // How far (in scroll px) the pane may sit from the desired position and still
+  // count as "near".
+  threshold: number;
+}
+
+/**
+ * Whether the pane is within `threshold` scroll pixels of the desired position.
+ * Used to skip redundant programmatic scrolls and to drive suspend/resume.
+ */
+export const isNearTarget = ({
+  paneScrollTop,
+  desiredScrollTop,
+  threshold,
+}: IsNearTargetArgs): boolean =>
+  Math.abs(paneScrollTop - desiredScrollTop) <= threshold;
+
+interface StepTowardsArgs {
+  // The pane's current scrollTop.
+  current: number;
+  // The scrollTop the animation is easing toward.
+  target: number;
+  // Wall-clock milliseconds since the previous tick (a Date.now() delta). A late
+  // tick — e.g. a throttled interval in an occluded tab — simply carries a larger
+  // dt, so its step is proportionally larger and the motion stays time-correct.
+  dtMs: number;
+  // Hard cap on speed, in scroll px per second. A step is never larger than
+  // maxVelocityPxS * dt, so a big jump pans at a bounded speed, never teleports.
+  maxVelocityPxS: number;
+  // Exponential-smoothing rate, per second. Governs the deceleration tail: the
+  // uncapped step is easeFactor * remainingDistance * dt.
+  easeFactor: number;
+}
+
+interface StepTowardsResult {
+  // The scrollTop to write this tick.
+  next: number;
+  // True once the target is reached (within the sub-pixel snap tolerance); the
+  // caller stops the loop.
+  done: boolean;
+}
+
+/**
+ * One tick of the eased, velocity-capped scroll animation. Pure: the caller
+ * writes `next` to pane.scrollTop and stops the loop when `done`.
+ *
+ * Motion model — critically-damped feel with a hard speed cap:
+ *   step = clamp(easeFactor * (target - current) * dt, ±maxVelocityPxS * dt)
+ * plus a no-overshoot clamp (the step never exceeds the remaining distance) so
+ * the approach is strictly monotonic, and a sub-pixel terminal snap: when the
+ * remaining gap is < 1px the result is snapped exactly onto target, done=true.
+ *
+ * Far from the target the velocity cap dominates (constant-speed pan); once
+ * within maxVelocityPxS / easeFactor px the eased term takes over and the motion
+ * decelerates into the target. A zero or negative dt yields no movement.
+ */
+export const stepTowards = ({
+  current,
+  target,
+  dtMs,
+  maxVelocityPxS,
+  easeFactor,
+}: StepTowardsArgs): StepTowardsResult => {
+  const delta = target - current;
+  const distance = Math.abs(delta);
+  // Already within the sub-pixel snap tolerance: finish exactly on target.
+  if (distance < 1) {
+    return { next: target, done: true };
+  }
+  const dtSeconds = Math.max(0, dtMs) / 1000;
+  // No time elapsed (or a bad dt): do not move, and do not report done.
+  if (dtSeconds === 0) {
+    return { next: current, done: false };
+  }
+  const direction = Math.sign(delta);
+  const easedMagnitude = easeFactor * distance * dtSeconds;
+  const velocityCap = maxVelocityPxS * dtSeconds;
+  // Cap by speed, then never overshoot the target (keeps the approach monotonic).
+  const magnitude = Math.min(easedMagnitude, velocityCap, distance);
+  const next = current + direction * magnitude;
+  // Terminal snap: if this step lands within a sub-pixel of the target, finish.
+  if (Math.abs(target - next) < 1) {
+    return { next: target, done: true };
+  }
+  return { next, done: false };
+};
diff --git a/ui/src/features/aiBuild/revertBuildTurn.ts b/ui/src/features/aiBuild/revertBuildTurn.ts
new file mode 100644
index 0000000..f316247
--- /dev/null
+++ b/ui/src/features/aiBuild/revertBuildTurn.ts
@@ -0,0 +1,78 @@
+import {
+  buildEnded,
+  buildReverted,
+  selectTurnSnapshot,
+  snapshotConsumed,
+} from '@/features/aiBuild/aiBuildSlice';
+import { abortActiveBuild } from '@/features/aiBuild/buildAbortRegistry';
+import {
+  selectLayout,
+  selectModel,
+  setLayoutModel,
+} from '@/features/layout/layoutModelSlice';
+
+import type { AppThunk } from '@/app/store';
+
+/**
+ * Stops the running AI build (if any) and restores the layout to its pre-turn
+ * snapshot in a single, natively-undoable step.
+ *
+ * Behavior:
+ * 1. Aborts the in-flight hop loop. The abort rejects the hop fetch / pause gate
+ *    with an AbortError, which the existing hop-loop catch swallows and whose
+ *    `.finally` dispatches buildEnded — so this thunk works during a build, while
+ *    paused, and after the turn completed (until the next turn overwrites the
+ *    snapshot).
+ * 2. Restores the layout with ONE setLayoutModel dispatch. The undo middleware
+ *    pushes exactly one undo entry per layoutModel action, so the whole turn
+ *    collapses into a single native Ctrl-Z (which is redo-able); further Ctrl-Z
+ *    presses then step through the individual pre-turn actions as usual.
+ * 3. Ends the build and clears the consumed snapshot.
+ *
+ * Scope is the layoutModel slice ONLY. Both AI component placements and AI prop
+ * edits land in layoutModel (edits round-trip through setLayoutModel in
+ * services/preview.ts), so a single layoutModel snapshot covers the whole turn's
+ * structural work. pageData (title/description) is intentionally NOT reverted:
+ * doing so would push a second, separate undo entry and break the one-Ctrl-Z
+ * promise.
+ *
+ * Manual edits the user makes after the turn completes are also rolled back by
+ * design — the snapshot restore replaces the whole layout — and are themselves
+ * recoverable with Ctrl-Z, since the restore is a normal undoable action.
+ */
+export const revertBuildTurn = (): AppThunk => (dispatch, getState) => {
+  // Abort first so no further hop can place components after we restore.
+  abortActiveBuild();
+
+  const state = getState();
+  const snapshot = selectTurnSnapshot(state);
+  if (!snapshot) {
+    // No snapshot to restore (never started, or a prior revert already consumed
+    // it — an idempotent second press). Still fail the build state to idle in
+    // case an abort left it mid-flight; no layoutModel dispatch, no announcement.
+    dispatch(buildEnded());
+    return;
+  }
+
+  // Cheap reference compare: immer only produces a new layout/model reference
+  // when something actually changed, so identical references mean the turn made
+  // no structural or prop change and there is nothing to restore. Skipping the
+  // dispatch here keeps a no-op revert from pushing an empty undo entry.
+  const changed =
+    selectLayout(state) !== snapshot.layout ||
+    selectModel(state) !== snapshot.model;
+  if (changed) {
+    dispatch(
+      setLayoutModel({
+        layout: snapshot.layout,
+        model: snapshot.model,
+        updatePreview: true,
+      }),
+    );
+  }
+
+  dispatch(buildEnded());
+  dispatch(snapshotConsumed());
+  // Announced last so the revert message wins over buildEnded's generic one.
+  dispatch(buildReverted(Date.now()));
+};
diff --git a/ui/src/features/aiBuild/useActiveComponentRect.ts b/ui/src/features/aiBuild/useActiveComponentRect.ts
new file mode 100644
index 0000000..f48106a
--- /dev/null
+++ b/ui/src/features/aiBuild/useActiveComponentRect.ts
@@ -0,0 +1,121 @@
+import { useEffect, useMemo, useState } from 'react';
+
+import { useAppSelector } from '@/app/hooks';
+import { selectActiveComponentUuid } from '@/features/aiBuild/aiBuildSlice';
+import { useDataToHtmlMapValue } from '@/features/layout/preview/DataToHtmlMapContext';
+import useSyncPreviewElementSize from '@/hooks/useSyncPreviewElementSize';
+
+// Re-measure cadence while the active component's elements exist but still
+// measure zero, and the per-element-set try budget (~5s total). Timers, never
+// requestAnimationFrame: Chrome suspends rAF in occluded windows, the same
+// lesson as the IframeSwapper swap watchdog.
+const MEASURE_RETRY_INTERVAL_MS = 200;
+const MEASURE_RETRY_MAX_TRIES = 25;
+
+interface Rect {
+  top: number;
+  left: number;
+  width: number;
+  height: number;
+}
+
+export interface ActiveComponentRect {
+  // The active component's box in UNSCALED preview-container coordinates (the
+  // same space ActiveComponentSpotlight renders in). Zeroed until a rect
+  // resolves.
+  rect: Rect;
+  // True once the active component's elements exist AND measure a non-zero box.
+  rectReady: boolean;
+  // The component currently targeted by the build (placement or edit), or null.
+  activeUuid: string | null;
+}
+
+/**
+ * Resolves the rect of the component an AI build is currently working on.
+ *
+ * Extracted from ActiveComponentSpotlight (Phase 7) so it can be shared: the
+ * Phase 8 "Follow Edits" scroller needs the same rect even when the
+ * component_spotlight flag is OFF, so this hook is deliberately flag-agnostic —
+ * it resolves whenever a component is marked active, regardless of
+ * component_spotlight. ActiveComponentSpotlight re-applies that flag itself, so
+ * its rendering and glow-suppression behavior are unchanged.
+ *
+ * Deliberately NOT gated on the build being active: a placement landing on the
+ * FINAL hop only becomes measurable after the preview swap + re-measure
+ * retries, by which time buildEnded has already fired — the Phase 8 follow pan
+ * still needs the rect then (the uuid itself survives buildEnded in the slice
+ * for the same reason). The spotlight is unaffected: its
+ * selectIsPerComponentSpotlightActive selector still requires an active build.
+ * Consequence: the size observers on the last active component stay attached
+ * while idle, until the next turn's buildStarted clears the uuid — accepted,
+ * the same class as the Phase 7 idle-observers deviation.
+ *
+ * The newly placed component's DOM appears in the iframe only after the preview
+ * refresh, so its rect is not available on the frame the placement dispatches.
+ * Until the rect resolves this reports rect-not-ready.
+ *
+ * Measurement retry: the annotations map often parses the freshly loaded
+ * preview buffer while that iframe is still hidden, so the component's elements
+ * exist but measure zero — and the buffer swap flips the IFRAME's visibility,
+ * which useSyncPreviewElementSize's observers (attached against the once-hidden
+ * document) never report. While elements are present but the rect is zero, a
+ * timer bumps `measureTick` to hand the hook a NEW array reference, re-running
+ * its layout effects (re-measure + observer re-attach) without modifying the
+ * shared hook. The timer stops when the rect resolves or the try budget is
+ * spent, restarts with a fresh budget when the target elements change, and
+ * never starts while no component is active (elements is null).
+ */
+const useActiveComponentRect = (): ActiveComponentRect => {
+  const activeUuid = useAppSelector(selectActiveComponentUuid);
+  const { componentsMap } = useDataToHtmlMapValue();
+
+  // Resolve a rect whenever a component is marked active — including after the
+  // build ends (see the doc block); useSyncPreviewElementSize handles a null
+  // input by returning a zero rect.
+  const elements = activeUuid ? componentsMap[activeUuid]?.elements : null;
+
+  // Bumped by the retry timer below purely to invalidate the memo underneath.
+  const [measureTick, setMeasureTick] = useState(0);
+
+  // The hook input: a NEW array reference per (elements, tick) pair, because
+  // the hook re-measures when — and only when — its input reference changes
+  // (or its internal observers fire, which they do not for a hidden-to-visible
+  // iframe swap; see the doc block).
+  const measuredElements = useMemo(() => {
+    // Read the tick so each bump yields a fresh reference; its value is unused.
+    void measureTick;
+    return elements?.length ? [...elements] : null;
+  }, [elements, measureTick]);
+  const { elementRect } = useSyncPreviewElementSize(measuredElements);
+
+  // The placed component's element exists AND has been measured to a non-zero
+  // box. Both are required: the map entry can appear while the element is still
+  // in the hidden buffer (zero box) or a frame before layout.
+  const rectReady =
+    Boolean(elements?.length) &&
+    elementRect.width > 0 &&
+    elementRect.height > 0;
+
+  // Retry loop. Re-runs (with a fresh local try budget) whenever the target
+  // elements change; its cleanup clears the timer when the rect resolves, the
+  // target changes, or no component is active.
+  useEffect(() => {
+    if (!elements?.length || rectReady) {
+      return;
+    }
+    let tries = 0;
+    const timer = setInterval(() => {
+      tries += 1;
+      if (tries > MEASURE_RETRY_MAX_TRIES) {
+        clearInterval(timer);
+        return;
+      }
+      setMeasureTick((tick) => tick + 1);
+    }, MEASURE_RETRY_INTERVAL_MS);
+    return () => clearInterval(timer);
+  }, [elements, rectReady]);
+
+  return { rect: elementRect, rectReady, activeUuid };
+};
+
+export default useActiveComponentRect;
