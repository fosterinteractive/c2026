@@ -0,0 +1,97 @@
+import { Provider } from 'react-redux';
+import { act, render, screen } from '@testing-library/react';
+
+import { makeStore } from '@/app/store';
+import {
+  buildEnded,
+  buildPaused,
+  buildResumed,
+  buildReverted,
+  buildStarted,
+} from '@/features/aiBuild/aiBuildSlice';
+import BuildStatusAnnouncer from '@/features/aiBuild/BuildStatusAnnouncer';
+import {
+  BUILD_ENDED_ANNOUNCEMENT,
+  BUILD_PAUSED_ANNOUNCEMENT,
+  BUILD_RESUMED_ANNOUNCEMENT,
+  BUILD_REVERTED_ANNOUNCEMENT,
+  BUILD_STARTED_ANNOUNCEMENT,
+} from '@/features/aiBuild/constants';
+
+describe('BuildStatusAnnouncer', () => {
+  it('announces build start and end through the live region', () => {
+    const store = makeStore();
+    render(
+      <Provider store={store}>
+        <BuildStatusAnnouncer />
+      </Provider>,
+    );
+
+    const liveRegion = screen.getByRole('status');
+    // Nothing is announced before a build starts.
+    expect(liveRegion.textContent).to.eq('');
+
+    // idle -> building announces the start.
+    act(() => {
+      store.dispatch(buildStarted({ requestId: 'req_1' }));
+    });
+    expect(liveRegion.textContent).to.eq(BUILD_STARTED_ANNOUNCEMENT);
+
+    // building -> idle announces the end.
+    act(() => {
+      store.dispatch(buildEnded());
+    });
+    expect(liveRegion.textContent).to.eq(BUILD_ENDED_ANNOUNCEMENT);
+  });
+
+  it('announces pause and resume transitions', () => {
+    const store = makeStore();
+    render(
+      <Provider store={store}>
+        <BuildStatusAnnouncer />
+      </Provider>,
+    );
+
+    const liveRegion = screen.getByRole('status');
+
+    act(() => {
+      store.dispatch(buildStarted({ requestId: 'req_1' }));
+    });
+    expect(liveRegion.textContent).to.eq(BUILD_STARTED_ANNOUNCEMENT);
+
+    // building -> paused announces the pause.
+    act(() => {
+      store.dispatch(buildPaused());
+    });
+    expect(liveRegion.textContent).to.eq(BUILD_PAUSED_ANNOUNCEMENT);
+
+    // paused -> building announces the resume.
+    act(() => {
+      store.dispatch(buildResumed());
+    });
+    expect(liveRegion.textContent).to.eq(BUILD_RESUMED_ANNOUNCEMENT);
+  });
+
+  it('announces a stop-and-revert, overriding the finished message', () => {
+    const store = makeStore();
+    render(
+      <Provider store={store}>
+        <BuildStatusAnnouncer />
+      </Provider>,
+    );
+
+    const liveRegion = screen.getByRole('status');
+    act(() => {
+      store.dispatch(buildStarted({ requestId: 'req_1' }));
+    });
+    expect(liveRegion.textContent).to.eq(BUILD_STARTED_ANNOUNCEMENT);
+
+    // revertBuildTurn ends the build AND marks the revert in the same commit.
+    // The revert message must win over the generic "build finished" one.
+    act(() => {
+      store.dispatch(buildEnded());
+      store.dispatch(buildReverted(Date.now()));
+    });
+    expect(liveRegion.textContent).to.eq(BUILD_REVERTED_ANNOUNCEMENT);
+  });
+});
diff --git a/ui/tests/vitest/unit/follow-scroll.test.js b/ui/tests/vitest/unit/follow-scroll.test.js
