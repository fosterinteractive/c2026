+     interaction. Keyboard interaction is blocked via the `inert` attribute. */
+  &.locked {
+    pointer-events: none;
+
+    /* Hide the empty-state drop targets ("Place items here") while locked:
+       dropping is disabled anyway, and their translucent blurred wash would
+       otherwise paint over the plan gen-cards during the initial scaffold —
+       this portalled overlay always paints above the whole editor frame (the
+       scaling container's transform makes the frame one stacking context and
+       a z-auto earlier sibling), so no z-index inside the frame can lift the
+       cards above it. */
+    .emptyPageContainer,
+    .emptyRegionContainer,
+    .emptySlotContainer {
+      display: none;
+    }
+  }
 }
 
 
