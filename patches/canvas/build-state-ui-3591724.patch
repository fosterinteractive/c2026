diff --git a/modules/canvas_ai/canvas_ai.install b/modules/canvas_ai/canvas_ai.install
new file mode 100644
index 0000000..ce7a68c
--- /dev/null
+++ b/modules/canvas_ai/canvas_ai.install
@@ -0,0 +1,152 @@
+<?php
+
+/**
+ * @file
+ * Install, update and uninstall functions for the Canvas AI module.
+ */
+
+declare(strict_types=1);
+
+/**
+ * Seed the build-state UI viewport-lock flag.
+ */
+function canvas_ai_update_100001(): void {
+  $config = \Drupal::configFactory()->getEditable('canvas_ai.settings');
+  if ($config->get('build_state.build_lock') === NULL) {
+    $config->set('build_state.build_lock', TRUE)->save();
+  }
+}
+
+/**
+ * Seed the build-state UI viewport-glow flag.
+ */
+function canvas_ai_update_100002(): void {
+  $config = \Drupal::configFactory()->getEditable('canvas_ai.settings');
+  if ($config->get('build_state.build_glow') === NULL) {
+    $config->set('build_state.build_glow', TRUE)->save();
+  }
+}
+
+/**
+ * Seed the smart-lock-timing flag and enable the lock_viewport marker tool.
+ */
+function canvas_ai_update_100003(): void {
+  $settings = \Drupal::configFactory()->getEditable('canvas_ai.settings');
+  if ($settings->get('build_state.smart_lock_timing') === NULL) {
+    $settings->set('build_state.smart_lock_timing', TRUE)->save();
+  }
+
+  // Enable the lock_viewport marker tool on the existing page builder agent so
+  // sites updated before this feature landed get it without reinstalling.
+  $agent = \Drupal::configFactory()->getEditable('ai_agents.ai_agent.canvas_page_builder_agent');
+  if ($agent->isNew()) {
+    // The agent config is not installed on this site; nothing to update.
+    return;
+  }
+  $tool_id = 'canvas_ai:lock_viewport';
+  $tools = $agent->get('tools') ?? [];
+  // Guard against double-adding when the update runs more than once.
+  if (array_key_exists($tool_id, $tools)) {
+    return;
+  }
+  $tools[$tool_id] = TRUE;
+  $agent->set('tools', $tools);
+
+  $tool_settings = $agent->get('tool_settings') ?? [];
+  $tool_settings[$tool_id] = [
+    'return_directly' => 0,
+    'require_usage' => 0,
+    'description_override' => '',
+    'progress_message' => '',
+    'use_artifacts' => 0,
+  ];
+  $agent->set('tool_settings', $tool_settings);
+
+  $tool_usage_limits = $agent->get('tool_usage_limits') ?? [];
+  $tool_usage_limits[$tool_id] = [];
+  $agent->set('tool_usage_limits', $tool_usage_limits);
+
+  $agent->save();
+}
+
+/**
+ * Seed the build-state UI pause/resume flag.
+ */
+function canvas_ai_update_100004(): void {
+  $config = \Drupal::configFactory()->getEditable('canvas_ai.settings');
+  if ($config->get('build_state.pause_resume') === NULL) {
+    $config->set('build_state.pause_resume', TRUE)->save();
+  }
+}
+
+/**
+ * Seed the build-state UI stop-and-revert flag.
+ */
+function canvas_ai_update_100005(): void {
+  $config = \Drupal::configFactory()->getEditable('canvas_ai.settings');
+  if ($config->get('build_state.stop_revert') === NULL) {
+    $config->set('build_state.stop_revert', TRUE)->save();
+  }
+}
+
+/**
+ * Seed the plan-skeletons flag and enable the set_build_plan tool.
+ */
+function canvas_ai_update_100006(): void {
+  $settings = \Drupal::configFactory()->getEditable('canvas_ai.settings');
+  if ($settings->get('build_state.plan_skeletons') === NULL) {
+    $settings->set('build_state.plan_skeletons', TRUE)->save();
+  }
+
+  // Enable the set_build_plan tool on the existing page builder agent so sites
+  // updated before this feature landed get it without reinstalling.
+  $agent = \Drupal::configFactory()->getEditable('ai_agents.ai_agent.canvas_page_builder_agent');
+  if ($agent->isNew()) {
+    // The agent config is not installed on this site; nothing to update.
+    return;
+  }
+  $tool_id = 'canvas_ai:set_build_plan';
+  $tools = $agent->get('tools') ?? [];
+  // Guard against double-adding when the update runs more than once.
+  if (array_key_exists($tool_id, $tools)) {
+    return;
+  }
+  $tools[$tool_id] = TRUE;
+  $agent->set('tools', $tools);
+
+  $tool_settings = $agent->get('tool_settings') ?? [];
+  $tool_settings[$tool_id] = [
+    'return_directly' => 0,
+    'require_usage' => 0,
+    'description_override' => '',
+    'progress_message' => '',
+    'use_artifacts' => 0,
+  ];
+  $agent->set('tool_settings', $tool_settings);
+
+  $tool_usage_limits = $agent->get('tool_usage_limits') ?? [];
+  $tool_usage_limits[$tool_id] = [];
+  $agent->set('tool_usage_limits', $tool_usage_limits);
+
+  $agent->save();
+}
+
+/**
+ * Seed the build-state UI per-component spotlight flag.
+ */
+function canvas_ai_update_100007(): void {
+  $config = \Drupal::configFactory()->getEditable('canvas_ai.settings');
+  if ($config->get('build_state.component_spotlight') === NULL) {
+    $config->set('build_state.component_spotlight', TRUE)->save();
+  }
+}
+
+/**
+ * Seed the build-state UI follow-edits auto-scroll flag.
+ */
+function canvas_ai_update_100008(): void {
+  $config = \Drupal::configFactory()->getEditable('canvas_ai.settings');
+  if ($config->get('build_state.follow_edits') === NULL) {
+    $config->set('build_state.follow_edits', TRUE)->save();
+  }
+}
