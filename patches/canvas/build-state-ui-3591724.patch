new file mode 100644
index 0000000..534a2c1
--- /dev/null
+++ b/ui/src/features/aiBuild/BuildGlow.tsx
@@ -0,0 +1,34 @@
+import clsx from 'clsx';
+
+import styles from './buildGlow.module.css';
+
+// Test id on the static border-glow ring. The Playwright glow test asserts it is
+// present while building and carries no animation.
+export const BUILD_GLOW_TESTID = 'canvas-build-glow';
+
+interface BuildGlowProps {
+  // isViewportGlowing from Viewport: an active build with the build_glow flag on
+  // and no per-component spotlight suppression. Drives the opacity fade in/out.
+  visible: boolean;
+}
+
+/**
+ * Phase 2 "AI is working" viewport glow: a static cyan-blue border glow hugging
+ * the page frame while the AI builds. One decorative element carries the ring (a
+ * crisp inner stroke plus a soft outer halo, drawn as a box-shadow in
+ * buildGlow.module.css); nothing animates. It stays mounted and only toggles the
+ * `visible` class, so the CSS opacity transition plays a real fade both in and
+ * out without any timers or requestAnimationFrame.
+ *
+ * Decorative only: aria-hidden, pointer-events none, and it never touches the
+ * glow suppression logic (that lives in Viewport / aiBuildSlice).
+ */
+const BuildGlow: React.FC<BuildGlowProps> = ({ visible }) => (
+  <div
+    className={clsx(styles.glow, { [styles.visible]: visible })}
+    data-testid={BUILD_GLOW_TESTID}
+    aria-hidden="true"
+  />
+);
+
+export default BuildGlow;
