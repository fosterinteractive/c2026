+    vi.resetModules();
+    vi.doMock('@/utils/drupal-globals', () => ({
+      getBuildStateFlags: () => ({ build_lock: true, build_glow: false }),
+    }));
+    const mod = await import('@/features/aiBuild/aiBuildSlice');
+    const building = mod.aiBuildSlice.reducer(
+      mod.initialState,
+      mod.buildStarted({ requestId: 'req_1' }),
