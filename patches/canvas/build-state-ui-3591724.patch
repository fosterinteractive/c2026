--- /dev/null
+++ b/ui/src/features/aiBuild/usePlanSpacerAnchor.ts
@@ -0,0 +1,339 @@
+import { useEffect, useState } from 'react';
+
+import { useAppSelector } from '@/app/hooks';
+import { selectActiveComponentUuid } from '@/features/aiBuild/aiBuildSlice';
+// The region the AI build places sections into ('content'); its map entry
+// matches the server's canvas-region-start-content annotation.
+import { DEFAULT_REGION } from '@/features/ui/uiSlice';
+import {
+  getElementsByIdInHTMLComment,
+  mapRegions,
+} from '@/utils/function-utils';
+
+import type { RefObject } from 'react';
+
+// Attribute marking the injected spacer so it can always be found and removed.
+const SPACER_ATTRIBUTE = 'data-canvas-plan-spacer';
+
+// Attribute tracking the entry fade of a newly placed component's elements.
+// Value is `pending:<epoch-ms>` after opacity 0 is applied and `done` once the
+// element has been revealed, so each element fades at most once per document
+// generation (a fresh srcdoc carries no marks).
+const FADED_ATTRIBUTE = 'data-canvas-faded';
+
+// Entry-fade duration for newly placed components.
+const FADE_DURATION_MS = 200;
+
+// Never leave an element stuck at opacity 0: any pending fade older than this
+// is force-revealed regardless of which buffer its document is in.
+const FADE_FORCE_REVEAL_MS = 1000;
+
+// Breathing room above and below the card strip inside the spacer. The top gap
+// matches the strip's own 12px margin-top (the strip is anchored at the
+// spacer's top edge, so its margin lands inside the spacer); the bottom gap
+// keeps the footer from hugging the last card.
+const SPACER_GAP_PX = 12;
+
+// Re-sync cadence while the plan is non-empty. Timers, never
+// requestAnimationFrame: Chrome suspends rAF in occluded windows, the same
+// lesson as the IframeSwapper swap watchdog and the useActiveComponentRect
+// retries. The loop is bounded by the plan itself — it only runs while
+// remaining sections exist, and each tick is a few cheap DOM reads.
+const SYNC_INTERVAL_MS = 250;
+
+// Ignore sub-pixel anchor jitter so the timer never causes render churn.
+const ANCHOR_EPSILON_PX = 0.5;
+
+// Both preview buffer iframes (active and hidden), by the marker attribute
+// IframeSwapper renders on each.
+const getPreviewFrames = (): HTMLIFrameElement[] =>
+  Array.from(
+    document.querySelectorAll<HTMLIFrameElement>('iframe[data-canvas-preview]'),
+  );
+
+/**
+ * Removes every injected spacer from every preview buffer document (the hidden
+ * buffer keeps its old DOM — spacer included — until its next srcdoc load).
+ */
+const removeAllSpacers = () => {
+  getPreviewFrames().forEach((frame) => {
+    frame.contentDocument
+      ?.querySelectorAll(`[${SPACER_ATTRIBUTE}]`)
+      .forEach((node) => node.remove());
+  });
+};
+
+/**
+ * Force-reveals every element still waiting on an entry fade, in every buffer
+ * document. Teardown safety: once the tick loop stops (plan empty, build end,
+ * unmount) nothing else would flip a pending opacity 0 back to 1.
+ */
+const revealAllPendingFades = () => {
+  getPreviewFrames().forEach((frame) => {
+    frame.contentDocument
+      ?.querySelectorAll<HTMLElement>(`[${FADED_ATTRIBUTE}^="pending"]`)
+      .forEach((el) => {
+        el.style.opacity = '1';
+        el.setAttribute(FADED_ATTRIBUTE, 'done');
+      });
+  });
+};
+
+/**
+ * Resolves the content region container in an arbitrary preview buffer
+ * document, with the exact resolver the overlay machinery uses (mapRegions
+ * special-cases 'content' to the parent container of the
+ * canvas-region-start-content comment, which ApiLayoutController always
+ * renders — empty page included). Called directly per document rather than
+ * through the DataToHtmlMapContext map because that map only ever describes
+ * the ACTIVE document, and the whole point of dual-buffer maintenance is
+ * preparing the hidden one.
+ */
+const resolveContentRegion = (doc: Document): HTMLElement | null =>
+  mapRegions(doc)[DEFAULT_REGION]?.elements?.[0] ?? null;
+
+/**
+ * Ensures the spacer exists as the content region container's last child of
+ * `doc` and carries the given pixel height. Returns the spacer, or null when
+ * the region cannot be resolved. The region walk only runs when the spacer is
+ * missing (once per document generation); ticks after that are two property
+ * checks.
+ */
+const ensureSpacer = (doc: Document, heightPx: string): HTMLElement | null => {
+  let spacer = doc.querySelector<HTMLElement>(`[${SPACER_ATTRIBUTE}]`);
+  if (!spacer?.parentElement) {
+    const regionEl = resolveContentRegion(doc);
+    if (!regionEl?.isConnected) {
+      return null;
+    }
+    spacer?.remove();
+    // Inline styles only — nothing that could bleed into page markup:
+    // transparent, inert, full-width, fixed pixel height.
+    spacer = doc.createElement('div');
+    spacer.setAttribute(SPACER_ATTRIBUTE, 'true');
+    spacer.setAttribute('aria-hidden', 'true');
+    spacer.style.cssText =
+      'width:100%;background:transparent;border:0;margin:0;padding:0;pointer-events:none;';
+    regionEl.appendChild(spacer);
+  } else if (spacer !== spacer.parentElement.lastElementChild) {
+    // Keep it last inside the region so it always sits below the newest
+    // in-place content mutation.
+    spacer.parentElement.appendChild(spacer);
+  }
+  if (spacer.style.height !== heightPx) {
+    spacer.style.height = heightPx;
+  }
+  return spacer;
+};
+
+/**
+ * Anchors the plan gen-card strip at the plan's real insertion point (Phase 6
+ * placement fix): inside the page's content region, after its last component,
+ * above the footer — instead of below ALL rendered content (top: 100% of the
+ * preview container, i.e. under the site footer).
+ *
+ * How: while sections remain, a spacer div is injected into BOTH preview
+ * buffer documents (same-origin srcdoc, mutable) as the last child of the
+ * content region's container. Appending inside the container reflows the
+ * iframe and pushes the footer down; useSyncIframeHeightToContent observes
+ * the mutation and grows the preview container to match — the desired "inside
+ * the page" effect. No feedback loop: the spacer's height is a fixed pixel
+ * value derived only from the strip's rendered height (card count and sizes),
+ * never from container or iframe size.
+ *
+ * Dual-buffer maintenance (per-write jump fix): every preview POST regenerates
+ * the srcdoc WITHOUT the spacer, so an active-buffer-only strategy presents a
+ * spacer-less document at every swap — the footer jumps up by the strip height
+ * for up to one tick, then back down when the tick re-injects. Instead, the
+ * HIDDEN buffer is prepared too: once its fresh document is fully loaded
+ * (readyState 'complete', the same readiness check as the IframeSwapper
+ * watchdog) and its content region resolves, the spacer is injected there as
+ * well, so the incoming document is already spaced when the swap presents it.
+ * The hidden buffer is deliberately NOT swept between swaps for the same
+ * reason. Maintenance is EVENT-DRIVEN, not just polled: swaps ride the iframe
+ * `load` event, so a poll-only strategy structurally loses the race (measured:
+ * spacer absent at most of the 66 swap boundaries in one traced build,
+ * test-artifacts/round7/y-trace.json). A `load` listener per buffer iframe
+ * runs the same idempotent maintenance in the load event's own task — before
+ * the next paint, so the fresh document is spaced and fade-seeded before it
+ * can be presented — while the 250ms tick remains as the backstop.
+ *
+ * The strip overlay then anchors over the ACTIVE document's spacer: its
+ * in-iframe getBoundingClientRect().top IS the strip's top in unscaled
+ * preview-container coordinates (the iframes are absolutely positioned at the
+ * container's origin with scrolling="no", the same coordinate space every
+ * overlay rect uses).
+ *
+ * Entry fade (softens the residual swap crossfade): while a build marks an
+ * active component, that component's elements are located per buffer document
+ * (getElementsByIdInHTMLComment — the canvas-start/end comment annotations)
+ * and faded in once per document generation. Lifecycle per element:
+ * 1. Seed — first sighting in a document (normally the hidden buffer, where a
+ *    fresh placement lands): opacity 0 + a 200ms ease transition, marked
+ *    `pending:<timestamp>`. Under prefers-reduced-motion the element is marked
+ *    done immediately and never dimmed.
+ * 2. Reveal — a LATER tick (the reveal pass runs before the seed pass, so a
+ *    seeded element is never revealed in the same tick and the browser has
+ *    painted opacity 0, making the transition real) sets opacity 1 once the
+ *    element's document is the active buffer — or unconditionally once the
+ *    pending mark is older than FADE_FORCE_REVEAL_MS, so nothing can stay
+ *    stuck invisible. Teardown also force-reveals everything pending.
+ *
+ * Purely decorative and client-side: spacer and fade never touch the Redux
+ * layout model or autosave. Neither can round-trip into saved state — autosave
+ * serializes the layout model, and the srcdoc is regenerated by the server on
+ * every preview POST (selectPreviewHtml), so any client-side DOM mutation is
+ * discarded wholesale on the next preview. That regeneration is also why
+ * re-injection is needed at all: every buffer swap replaces the document.
+ *
+ * Fallback: while the active document's content region cannot be resolved
+ * (iframe not ready or markup without the region), this returns null and the
+ * strip keeps its CSS top: 100% placement — cards are never invisible.
+ *
+ * @param stripRef - Ref to the rendered card strip (measured for the spacer height).
+ * @param activeCount - Remaining planned sections while the build is active, else 0.
+ * @returns The strip's anchored top in preview-container pixels, or null to use
+ *   the top: 100% fallback.
+ */
+const usePlanSpacerAnchor = (
+  stripRef: RefObject<HTMLDivElement | null>,
+  activeCount: number,
+): number | null => {
+  const activeComponentUuid = useAppSelector(selectActiveComponentUuid);
+  const [anchorTop, setAnchorTop] = useState<number | null>(null);
+
+  useEffect(() => {
+    if (activeCount === 0) {
+      // Plan finished, build ended, or nothing planned: tear down and fall
+      // back. Removal here (not in the interval cleanup) keeps effect re-runs
+      // from thrashing the spacer out and back in.
+      removeAllSpacers();
+      revealAllPendingFades();
+      setAnchorTop(null);
+      return;
+    }
+
+    // Full maintenance of ONE buffer: fade reveal pass, fade seed pass, and
+    // spacer injection/sizing. Returns the spacer's top when this is the
+    // active buffer (the strip's anchor), else null. Idempotent and cheap, so
+    // it is safe to run from both the tick and the load listeners below.
+    const maintainFrame = (frame: HTMLIFrameElement): number | null => {
+      const stripEl = stripRef.current;
+      const doc = frame.contentDocument;
+      const isActive = frame.dataset.canvasSwapActive === 'true';
+      // The active buffer is maintained as soon as it has a body; the hidden
+      // buffer only once its fresh srcdoc has fully loaded, so a mid-parse
+      // document is never touched.
+      if (
+        !stripEl ||
+        !doc?.body ||
+        (!isActive && doc.readyState !== 'complete')
+      ) {
+        return null;
+      }
+      // Height = the strip's rendered height (mixed short/tall cards and gaps
+      // included, via offsetHeight) plus the top/bottom gaps. A fixed pixel
+      // value per remaining plan, so the container height sync can never feed
+      // back into the spacer.
+      const spacerHeight = `${stripEl.offsetHeight + SPACER_GAP_PX * 2}px`;
+      const prefersReducedMotion = window.matchMedia(
+        '(prefers-reduced-motion: reduce)',
+      ).matches;
+      const now = Date.now();
+
+      // Entry-fade reveal pass — BEFORE the seed pass, so an element seeded
+      // in this run keeps its painted opacity 0 until a later run and the
+      // 200ms transition actually animates. Scans ALL pending marks (not
+      // just the current active component's), so a target change can never
+      // strand the previous component's elements at opacity 0.
+      doc
+        .querySelectorAll<HTMLElement>(`[${FADED_ATTRIBUTE}^="pending"]`)
+        .forEach((el) => {
+          const seededAt = Number(
+            el.getAttribute(FADED_ATTRIBUTE)?.split(':')[1] ?? 0,
+          );
+          if (isActive || now - seededAt > FADE_FORCE_REVEAL_MS) {
+            el.style.opacity = '1';
+            el.setAttribute(FADED_ATTRIBUTE, 'done');
+          }
+        });
+
+      // Entry-fade seed pass: dim the active component's elements on their
+      // first sighting in this document generation.
+      if (activeComponentUuid) {
+        getElementsByIdInHTMLComment(activeComponentUuid, doc).forEach((el) => {
+          if (el.hasAttribute(FADED_ATTRIBUTE)) {
+            return;
+          }
+          if (prefersReducedMotion) {
+            el.setAttribute(FADED_ATTRIBUTE, 'done');
+            return;
+          }
+          el.style.transition = `opacity ${FADE_DURATION_MS}ms ease`;
+          el.style.opacity = '0';
+          el.setAttribute(FADED_ATTRIBUTE, `pending:${now}`);
+        });
+      }
+
+      // Spacer maintenance in this buffer; the anchor reads from the active
+      // document's spacer only. In-iframe client coordinates ARE unscaled
+      // preview-container coordinates (see the doc block).
+      const spacer = ensureSpacer(doc, spacerHeight);
+      return spacer && isActive ? spacer.getBoundingClientRect().top : null;
+    };
+
+    const sync = () => {
+      let anchor: number | null = null;
+      getPreviewFrames().forEach((frame) => {
+        anchor = maintainFrame(frame) ?? anchor;
+      });
+      setAnchorTop((previous) => {
+        if (anchor === null) {
+          return null;
+        }
+        return previous !== null &&
+          Math.abs(previous - anchor) < ANCHOR_EPSILON_PX
+          ? previous
+          : anchor;
+      });
+    };
+
+    // Event-driven maintenance (jump-fix, measured): buffer swaps are driven
+    // by the iframe `load` event while this hook used to only poll — so the
+    // swap structurally won the race and presented spacer-less documents at
+    // most swap boundaries (trace: 66 swaps/build, spacer absent at
+    // presentation, test-artifacts/round7/y-trace.json). A `load` listener on
+    // each buffer iframe (stable DOM nodes per IframeSwapper) runs the same
+    // idempotent maintenance for the freshly loaded document within the same
+    // task as the load event — before the next paint, regardless of listener
+    // order relative to IframeSwapper's own swap listener — so the document is
+    // spaced and fade-seeded before it can be presented.
+    const frames = getPreviewFrames();
+    const onFrameLoad = (event: Event) => {
+      maintainFrame(event.currentTarget as HTMLIFrameElement);
+    };
+    frames.forEach((frame) => frame.addEventListener('load', onFrameLoad));
+
+    // The 250ms tick stays as the backstop (initial render, anchor tracking as
+    // components land above the spacer, force-reveal deadlines, late loads).
+    sync();
+    const timer = setInterval(sync, SYNC_INTERVAL_MS);
+    return () => {
+      clearInterval(timer);
+      frames.forEach((frame) => frame.removeEventListener('load', onFrameLoad));
+    };
+  }, [activeCount, activeComponentUuid, stripRef]);
+
+  // Unmount-only teardown: never leave a spacer behind or an element dimmed.
+  useEffect(
+    () => () => {
+      removeAllSpacers();
+      revealAllPendingFades();
+    },
+    [],
+  );
+
+  return anchorTop;
+};
+
+export default usePlanSpacerAnchor;
