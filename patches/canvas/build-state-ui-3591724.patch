+// The stop-and-revert tests need a fixture that actually PLACES components, so
+// they enable canvas_test_sdc and drive a fixture whose hop1 returns an
+// `operations` payload placing two `sdc.canvas_test_sdc.my-hero` components. The
+// other build-state fixtures place nothing (no `operations`), which is why they
+// cannot exercise the revert.
+test.describe('AI Build State — stop and revert', () => {
+  test.use({
+    modules: ['canvas_ai_test', 'canvas_test_sdc'],
+    enableTestExtensions: true,
+  });
+
+  // Placed hero components render in the preview overlay with this id.
+  const HERO_SELECTOR =
+    '#canvasPreviewOverlay [data-canvas-component-id="sdc.canvas_test_sdc.my-hero"]';
+
+  test.beforeEach(async ({ drupal }) => {
+    await drupal.loginAsAdmin();
+    await drupal.createRole({ name: 'ai_editor' });
+    await drupal.createUser({
+      email: `ai_editor@example.com`,
+      username: 'ai_editor',
+      password: 'ai_editor',
+      roles: ['ai_editor'],
+    });
+    await drupal.addPermissions({
+      role: 'ai_editor',
+      permissions: [
+        'create canvas_page',
+        'edit canvas_page',
+        'publish auto-saves',
+        'administer code components',
+        'use drupal canvas ai',
+        'create media',
+      ],
+    });
+    await drupal.logout();
+  });
+
+  test("stop-and-revert removes the turn's components in one step and Ctrl-Z restores them", async ({
+    page,
+    drupal,
+    canvas,
+    ai,
+  }) => {
+    await drupal.login({ username: 'ai_editor', password: 'ai_editor' });
+    await canvas.createCanvas();
+    await ai.openPanel();
+
+    await ai.submitQuery('Build me a revertible page');
+
+    // Let the build run to completion; the turn placed two hero components.
+    await expect(
+      page.getByText('I built a page with two sections.'),
+    ).toBeVisible();
+    const heroes = page.locator(HERO_SELECTOR);
+    await expect(heroes).toHaveCount(2);
+
+    // Stop and revert: the turn's components are removed in a single step.
+    const revert = page.getByTestId('canvas-build-stop-revert');
+    await expect(revert).toBeVisible();
+    await revert.click();
+    await expect(heroes).toHaveCount(0);
+
+    // A single native Ctrl-Z restores the whole build (and is redo-able). Focus
+    // must leave the chat panel first: AiWizard stops keydown propagation, so
+    // the document-level mod+z undo hotkey only fires from outside it.
+    await page.getByTestId('canvas-viewport-container').click();
+    await page.keyboard.press('ControlOrMeta+z');
+    await expect(heroes).toHaveCount(2);
+  });
+
+  test('revert available and functional after turn completion', async ({
+    page,
+    drupal,
+    canvas,
+    ai,
+  }) => {
+    await drupal.login({ username: 'ai_editor', password: 'ai_editor' });
+    await canvas.createCanvas();
+    await ai.openPanel();
+
+    await ai.submitQuery('Build me a revertible page');
+
+    // The turn finishes and its two components are on the page.
+    await expect(
+      page.getByText('I built a page with two sections.'),
+    ).toBeVisible();
+    const heroes = page.locator(HERO_SELECTOR);
+    await expect(heroes).toHaveCount(2);
+
+    // The revert control stays available after the turn ends (the snapshot
+    // survives completion), and it still reverts the finished turn.
+    const revert = page.getByTestId('canvas-build-stop-revert');
+    await expect(revert).toBeVisible();
+    await revert.click();
+    await expect(heroes).toHaveCount(0);
+
+    // Once used, the snapshot is consumed and the control disappears.
+    await expect(revert).toBeHidden();
+  });
+});
