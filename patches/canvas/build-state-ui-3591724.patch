diff --git a/ui/src/features/aiBuild/ActiveComponentSpotlight.module.css b/ui/src/features/aiBuild/ActiveComponentSpotlight.module.css
new file mode 100644
index 0000000..2053494
--- /dev/null
+++ b/ui/src/features/aiBuild/ActiveComponentSpotlight.module.css
@@ -0,0 +1,34 @@
+/**
+ * Per-component glow (Phase 7). An absolutely positioned div sized to the active
+ * component's rect (unscaled iframe coordinates, inside .previewContainer),
+ * drawn over the Spotlight cutout. It reuses the Phase 2 glow visual language
+ * (see buildGlow.module.css): the same box-shadow tokens, an opacity-only pulse,
+ * and a static border under reduced motion. It never captures pointer events.
+ */
+.componentGlow {
+  position: absolute;
+  animation: canvas-component-glow-pulse 1.6s ease-in-out infinite alternate;
+  pointer-events: none;
+  border-radius: 2px;
+  box-shadow:
+    0 0 0 2px var(--accent-8),
+    0 0 24px 4px var(--accent-7);
+}
+
+@keyframes canvas-component-glow-pulse {
+  from {
+    opacity: 0.35;
+  }
+
+  to {
+    opacity: 1;
+  }
+}
+
+/* Respect reduced-motion: keep a static glow, drop the pulse. */
+@media (prefers-reduced-motion: reduce) {
+  .componentGlow {
+    animation: none;
+    opacity: 1;
+  }
+}
diff --git a/ui/src/features/aiBuild/ActiveComponentSpotlight.tsx b/ui/src/features/aiBuild/ActiveComponentSpotlight.tsx
new file mode 100644
index 0000000..fab3cea
--- /dev/null
+++ b/ui/src/features/aiBuild/ActiveComponentSpotlight.tsx
@@ -0,0 +1,72 @@
+import { useEffect } from 'react';
+
+import { useAppSelector } from '@/app/hooks';
+import { Spotlight } from '@/components/spotlight/Spotlight';
+import { selectIsPerComponentSpotlightActive } from '@/features/aiBuild/aiBuildSlice';
+import useActiveComponentRect from '@/features/aiBuild/useActiveComponentRect';
+
+import styles from './ActiveComponentSpotlight.module.css';
+
+// Test id on the per-component glow element (Phase 7).
+export const COMPONENT_SPOTLIGHT_TESTID = 'canvas-component-spotlight';
+
+interface Props {
+  // Reports whether the active component's rect is available in the preview DOM
+  // so Viewport can suppress the whole-viewport glow (Phase 2) exactly while the
+  // per-component glow is visible, and never render both at once. The rect is a
+  // DOM-derived value, so it is lifted to Viewport via this callback rather than
+  // stored in Redux.
+  onRectReadyChange: (ready: boolean) => void;
+}
+
+/**
+ * Per-component spotlight (Phase 7).
+ *
+ * While a build is placing or editing a component, the active component glows
+ * and a translucent scrim covers the rest of the locked viewport with a clear
+ * cutout over that component. It renders inside .previewContainer in unscaled
+ * iframe coordinates, mirroring RegionSpotlight: the same Spotlight scrim-with-
+ * cutout, and a glow div reusing the Phase 2 glow visual language.
+ *
+ * The rect resolution (map lookup, measurement, and the re-measure retry) lives
+ * in useActiveComponentRect so it can be shared with the Phase 8 "Follow Edits"
+ * scroller. That hook is flag-agnostic; this component re-applies the
+ * component_spotlight flag here, so it renders — and reports rect-readiness —
+ * only when the flag is on, exactly as before. It is always mounted and gated
+ * internally so the readiness callback has a stable lifecycle; when no component
+ * is active it resolves to no rect and reports not-ready.
+ */
+const ActiveComponentSpotlight = ({ onRectReadyChange }: Props) => {
+  const isSpotlightActive = useAppSelector(selectIsPerComponentSpotlightActive);
+  const { rect, rectReady } = useActiveComponentRect();
+
+  // Gate on the component_spotlight flag: the hook resolves a rect whenever a
+  // build targets a component (so the scroller can use it with the flag off),
+  // but this component only renders the spotlight — and only suppresses the
+  // whole-viewport glow — while the flag is on.
+  const spotlightReady = isSpotlightActive && rectReady;
+
+  // Lift the DOM-derived readiness to Viewport so it can suppress the
+  // whole-viewport glow. onRectReadyChange is a stable state setter.
+  useEffect(() => {
+    onRectReadyChange(spotlightReady);
+  }, [spotlightReady, onRectReadyChange]);
+
+  if (!spotlightReady) {
+    return null;
+  }
+
+  const { top, left, width, height } = rect;
+  return (
+    <>
+      <Spotlight top={top} left={left} width={width} height={height} blocking />
+      <div
+        data-testid={COMPONENT_SPOTLIGHT_TESTID}
+        className={styles.componentGlow}
+        style={{ top, left, width, height }}
+      />
+    </>
+  );
+};
+
+export default ActiveComponentSpotlight;
