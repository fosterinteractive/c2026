+// The plan-skeleton tests need fixtures that both declare a build_plan (hop1)
+// and place components (hop2/hop3), so they enable canvas_test_sdc and drive
+// fixtures whose hop1 returns a `build_plan` with two sections and whose later
+// hops place `sdc.canvas_test_sdc.my-hero` components.
+test.describe('AI Build State — plan skeletons', () => {
+  test.use({
+    modules: ['canvas_ai_test', 'canvas_test_sdc'],
+    enableTestExtensions: true,
+  });
+
+  test.beforeEach(async ({ drupal }) => {
+    await drupal.loginAsAdmin();
+    await drupal.createRole({ name: 'ai_editor' });
+    await drupal.createUser({
+      email: `ai_editor@example.com`,
+      username: 'ai_editor',
+      password: 'ai_editor',
+      roles: ['ai_editor'],
+    });
+    await drupal.addPermissions({
+      role: 'ai_editor',
+      permissions: [
+        'create canvas_page',
+        'edit canvas_page',
+        'publish auto-saves',
+        'administer code components',
+        'use drupal canvas ai',
+        'create media',
+      ],
+    });
+    await drupal.logout();
+  });
+
+  test('skeletons appear in plan order before content and shrink as components land', async ({
+    page,
+    drupal,
+    canvas,
+    ai,
+  }) => {
+    await drupal.login({ username: 'ai_editor', password: 'ai_editor' });
+    await canvas.createCanvas();
+    await ai.openPanel();
+
+    await ai.submitQuery('Build me a planned page');
+
+    // hop1 declares a two-section plan, so two gray skeletons appear — in plan
+    // order (Hero then Features) — before any real section is placed.
+    const skeletons = page.getByTestId('canvas-plan-skeleton');
+    await expect(skeletons).toHaveCount(2);
+    await expect(skeletons.nth(0)).toHaveText('Hero');
+    await expect(skeletons.nth(1)).toHaveText('Features');
+
+    // hop2 places the first section, so its skeleton drops and only the second
+    // (Features) remains.
+    await expect(skeletons).toHaveCount(1);
+    await expect(skeletons.nth(0)).toHaveText('Features');
+
+    // On completion the remaining skeletons clear.
+    await expect(
+      page.getByText('I built a planned page with two sections.'),
+    ).toBeVisible();
+    await expect(skeletons).toHaveCount(0);
+  });
+
+  test('spotlights the active component and suppresses the whole-viewport glow', async ({
+    page,
+    drupal,
+    canvas,
+    ai,
+  }) => {
+    await drupal.login({ username: 'ai_editor', password: 'ai_editor' });
+    await canvas.createCanvas();
+    await ai.openPanel();
