index 0000000..0f37dcd
--- /dev/null
+++ b/ui/src/features/aiBuild/BuildPanel.module.css
@@ -0,0 +1,154 @@
+/**
+ * Figma-style floating build panel. A compact dark pill anchored bottom-center
+ * over the editor frame — a sibling of the scrolling pane, so it stays put while
+ * the canvas scrolls — above the lock overlay (z-index 100) so its controls stay
+ * clickable while the viewport is locked. The pill is persistent: while idle its
+ * controls fade to a disabled state instead of unmounting. A single centered
+ * row: the working dots, status text, labeled Pause/Resume Build toggle, Follow
+ * Edits switch, and the small revert button inline at the end.
+ */
+.panel {
+  position: absolute;
+  z-index: 110;
+  bottom: 20px;
+  left: 50%;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  padding: 10px 12px;
+  transform: translateX(-50%);
+  pointer-events: all;
+  color: #fff;
+  border-radius: 10px;
+  background: rgb(0, 0, 0, 0.78);
+  box-shadow: 0 8px 24px 2px rgb(0, 0, 0, 0.35);
+  gap: 6px;
+  backdrop-filter: blur(8px);
+}
+
+/* Line 1: working dots, status text, then the labeled controls inline. */
+.statusRow {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+}
+
+/* Three-dot "I'm working" indicator: staggered typing-indicator pulse while a
+   hop is running, static while paused, static and faded while idle. */
+.dots {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+}
+
+.dotsIdle {
+  opacity: 0.45;
+}
+
+.dot {
+  width: 5px;
+  height: 5px;
+  border-radius: 50%;
+  background: rgb(255, 255, 255, 0.85);
+}
+
+.dots[data-animating='true'] .dot {
+  animation: dot-pulse 1.2s infinite ease-in-out;
+}
+
+.dots[data-animating='true'] .dot:nth-child(2) {
+  animation-delay: 0.15s;
+}
+
+.dots[data-animating='true'] .dot:nth-child(3) {
+  animation-delay: 0.3s;
+}
+
+@keyframes dot-pulse {
+  0%,
+  60%,
+  100% {
+    transform: translateY(0);
+    opacity: 0.45;
+  }
+
+  30% {
+    transform: translateY(-3px);
+    opacity: 1;
+  }
+}
+
+/* Motion sensitivity: keep the dots static; state still shows via fading. */
+@media (prefers-reduced-motion: reduce) {
+  .dots[data-animating='true'] .dot {
+    animation: none;
+  }
+}
+
+.status {
+  white-space: nowrap;
+  font-size: var(--font-size-1);
+}
+
+/* Compact labeled toggle: a Pause icon + "Pause Build" while building, a Play
+   icon + "Resume Build" while paused. Disabled (idle) it fades but stays put. */
+.toggle {
+  display: inline-flex;
+  align-items: center;
+  padding: 5px 10px;
+  cursor: pointer;
+  white-space: nowrap;
+  color: #fff;
+  border: none;
+  border-radius: 6px;
+  background: rgb(255, 255, 255, 0.12);
+  font-size: var(--font-size-1);
+  gap: 6px;
+
+  &:hover:not(:disabled) {
+    background: rgb(255, 255, 255, 0.22);
+  }
+
+  &:disabled {
+    cursor: default;
+    opacity: 0.45;
+  }
+}
+
+/* Follow Edits switch + label, restyled small and light for the dark pill.
+   Disabled (idle) it fades but stays put. */
+.follow {
+  display: inline-flex;
+  align-items: center;
+  cursor: pointer;
+  white-space: nowrap;
+  color: #fff;
+  font-size: var(--font-size-1);
+  gap: 6px;
+}
+
+.followIdle {
+  cursor: default;
+  opacity: 0.45;
+}
+
+/* Destructive revert, inline at the end of the row: small subdued red text
+   with a Phosphor revert icon. The padding keeps a comfortable hit area
+   despite the small type. */
+.revert {
+  display: inline-flex;
+  align-items: center;
+  padding: 4px 8px;
+  cursor: pointer;
+  white-space: nowrap;
+  color: #ffb3b5;
+  border: none;
+  background: none;
+  font-size: 11px;
+  gap: 5px;
+
+  &:hover {
+    text-decoration: underline;
+    color: #ffd2d3;
+  }
+}
diff --git a/ui/src/features/aiBuild/BuildPanel.tsx b/ui/src/features/aiBuild/BuildPanel.tsx
new file mode 100644
index 0000000..79ba24f
--- /dev/null
+++ b/ui/src/features/aiBuild/BuildPanel.tsx
@@ -0,0 +1,169 @@
+import clsx from 'clsx';
+import {
+  ArrowCounterClockwiseIcon,
+  PauseIcon,
+  PlayIcon,
+} from '@phosphor-icons/react';
+import { Switch } from '@radix-ui/themes';
+
+import { useAppDispatch, useAppSelector } from '@/app/hooks';
+import {
+  buildPaused,
+  buildResumed,
+  selectBuildStatus,
+  selectFollowEdits,
+  selectIsBuildActive,
+  selectIsCanvasLocked,
+  selectTurnSnapshot,
+  setFollowEdits,
+} from '@/features/aiBuild/aiBuildSlice';
+import {
+  BUILD_CONTROLS_TESTID,
+  BUILD_PAUSE_TOGGLE_TESTID,
+  BUILD_STOP_REVERT_TESTID,
+  BUILD_WORKING_DOTS_TESTID,
+  BUILD_WORKING_LABEL,
+  FOLLOW_EDITS_LABEL,
+  FOLLOW_EDITS_TOGGLE_TESTID,
+  PAUSE_BUILD_LABEL,
+  RESUME_BUILD_LABEL,
+  REVERT_TURN_LABEL,
+  VIEWPORT_LOCKED_LABEL,
+} from '@/features/aiBuild/constants';
+import { revertBuildTurn } from '@/features/aiBuild/revertBuildTurn';
+import { getBuildStateFlags } from '@/utils/drupal-globals';
+
+import styles from './BuildPanel.module.css';
+
+// Build-state feature flags are read once at module scope, mirroring the slice.
+const buildStateFlags = getBuildStateFlags();
+
+/**
+ * Figma-style floating build panel: a compact dark pill anchored bottom-center
+ * over the editor frame. It is persistent — always rendered over the canvas,
+ * idle or not — so the controls never pop in and out of the layout. A single
+ * centered row: the animated working dots, status text, labeled Pause/Resume
+ * Build toggle, Follow Edits switch, and the small destructive revert button
+ * inline at the end. While no build is active the dots sit static and faded and
+ * the toggle/switch are visible but disabled and faded. Each control keeps its
+ * own feature-flag-gated visibility rule; with every flag off the panel renders
+ * nothing.
+ */
+const BuildPanel = () => {
+  const dispatch = useAppDispatch();
+  const isActive = useAppSelector(selectIsBuildActive);
+  const isLocked = useAppSelector(selectIsCanvasLocked);
+  const status = useAppSelector(selectBuildStatus);
+  const turnSnapshot = useAppSelector(selectTurnSnapshot);
+  const followEdits = useAppSelector(selectFollowEdits);
+
+  // Per-control flag gates. Pause/Resume and Follow Edits stay mounted while
+  // idle (disabled + faded); only their feature flags remove them.
+  const showPauseToggle = buildStateFlags.pause_resume;
+  const showFollowEdits = buildStateFlags.follow_edits;
+  // The revert control stays available after the turn ends — until the snapshot
+  // is consumed (by a revert) or replaced (by the next build) — so a finished
+  // turn can still be undone in one step.
+  const showRevert =
+    buildStateFlags.stop_revert && (isActive || turnSnapshot !== null);
+
+  // Every build-state control is flagged off: keep the panel out of the layout.
+  if (
+    !buildStateFlags.pause_resume &&
+    !buildStateFlags.follow_edits &&
+    !buildStateFlags.stop_revert
+  ) {
+    return null;
+  }
+
+  const isPaused = status === 'paused';
+
+  // Status text: the lock message while the viewport is held, a shorter working
+  // note while an active build has smart-unlocked (a trivial turn), and nothing
+  // while idle.
+  let statusText = '';
+  if (isLocked) {
+    statusText = VIEWPORT_LOCKED_LABEL;
+  } else if (isActive) {
+    statusText = BUILD_WORKING_LABEL;
+  }
+
+  const handleToggle = () => {
+    if (isPaused) {
+      dispatch(buildResumed());
+    } else {
+      dispatch(buildPaused());
+    }
+  };
+
+  const handleRevert = () => {
+    dispatch(revertBuildTurn());
+  };
+
+  return (
+    <div className={styles.panel} data-testid={BUILD_CONTROLS_TESTID}>
+      <div className={styles.statusRow}>
+        {/* Decorative "I'm working" dots: animated while building, static while
+            paused, static and faded while idle. */}
+        <span
+          className={clsx(styles.dots, !isActive && styles.dotsIdle)}
+          data-testid={BUILD_WORKING_DOTS_TESTID}
+          data-animating={status === 'building' ? 'true' : 'false'}
+          aria-hidden="true"
+        >
+          <span className={styles.dot} />
+          <span className={styles.dot} />
+          <span className={styles.dot} />
+        </span>
+        {statusText && <span className={styles.status}>{statusText}</span>}
+        {showPauseToggle && (
+          <button
+            type="button"
+            className={styles.toggle}
+            onClick={handleToggle}
+            disabled={!isActive}
+            aria-disabled={!isActive}
+            aria-label={isPaused ? RESUME_BUILD_LABEL : PAUSE_BUILD_LABEL}
+            aria-pressed={isPaused}
+            data-testid={BUILD_PAUSE_TOGGLE_TESTID}
+          >
+            {isPaused ? (
+              <PlayIcon size={15} weight="fill" />
+            ) : (
+              <PauseIcon size={15} weight="fill" />
+            )}
+            {isPaused ? RESUME_BUILD_LABEL : PAUSE_BUILD_LABEL}
+          </button>
+        )}
+        {showFollowEdits && (
+          <label
+            className={clsx(styles.follow, !isActive && styles.followIdle)}
+          >
+            <Switch
+              size="1"
+              checked={followEdits}
+              onCheckedChange={(checked) => dispatch(setFollowEdits(checked))}
+              disabled={!isActive}
+              aria-disabled={!isActive}
+              data-testid={FOLLOW_EDITS_TOGGLE_TESTID}
+            />
+            {FOLLOW_EDITS_LABEL}
+          </label>
+        )}
+        {showRevert && (
+          <button
+            type="button"
+            className={styles.revert}
+            onClick={handleRevert}
+            data-testid={BUILD_STOP_REVERT_TESTID}
+          >
+            <ArrowCounterClockwiseIcon size={13} weight="bold" />
+            {REVERT_TURN_LABEL}
+          </button>
+        )}
+      </div>
+    </div>
+  );
+};
+
+export default BuildPanel;
diff --git a/ui/src/features/aiBuild/BuildStatusAnnouncer.tsx b/ui/src/features/aiBuild/BuildStatusAnnouncer.tsx
new file mode 100644
index 0000000..2af13b1
--- /dev/null
+++ b/ui/src/features/aiBuild/BuildStatusAnnouncer.tsx
@@ -0,0 +1,103 @@
+import { useEffect, useRef, useState } from 'react';
+
+import { useAppSelector } from '@/app/hooks';
+import {
+  selectBuildStatus,
+  selectLastRevertedAt,
+} from '@/features/aiBuild/aiBuildSlice';
+import {
+  BUILD_ANNOUNCER_TESTID,
+  BUILD_ENDED_ANNOUNCEMENT,
+  BUILD_PAUSED_ANNOUNCEMENT,
+  BUILD_RESUMED_ANNOUNCEMENT,
+  BUILD_REVERTED_ANNOUNCEMENT,
+  BUILD_STARTED_ANNOUNCEMENT,
+} from '@/features/aiBuild/constants';
+
+// How long the "build finished" message stays in the live region before it is
+// cleared so it does not linger for the next screen-reader sweep.
+const ANNOUNCEMENT_CLEAR_DELAY = 3000;
+
+/**
+ * Always-mounted, visually-hidden live region that announces AI build lifecycle
+ * changes to assistive technology: start, pause, resume, finish, and a
+ * stop-and-revert. It belongs to the lock/accessibility story and mounts
+ * regardless of the glow flag; it speaks on real build status transitions
+ * (idle -> building, and any state -> idle) and when a revert bumps
+ * lastRevertedAt (which takes precedence over the finished message).
+ */
+const BuildStatusAnnouncer = () => {
+  const status = useAppSelector(selectBuildStatus);
+  const lastRevertedAt = useAppSelector(selectLastRevertedAt);
+  const previousStatusRef = useRef(status);
+  const previousRevertedAtRef = useRef(lastRevertedAt);
+  const [announcement, setAnnouncement] = useState('');
+
+  useEffect(() => {
+    const previousStatus = previousStatusRef.current;
+    const previousRevertedAt = previousRevertedAtRef.current;
+    previousStatusRef.current = status;
+    previousRevertedAtRef.current = lastRevertedAt;
+
+    // A revert bumps lastRevertedAt in the same commit that flips status to
+    // idle. Handle it first so its message wins over the generic "build
+    // finished" one buildEnded would otherwise trigger, then clear it like the
+    // finished message so it does not linger for the next sweep.
+    if (lastRevertedAt !== null && lastRevertedAt !== previousRevertedAt) {
+      setAnnouncement(BUILD_REVERTED_ANNOUNCEMENT);
+      const timer = window.setTimeout(
+        () => setAnnouncement(''),
+        ANNOUNCEMENT_CLEAR_DELAY,
+      );
+      return () => window.clearTimeout(timer);
+    }
+
+    if (previousStatus === status) {
+      return;
+    }
+
+    // idle -> building: a build just started. Resuming from paused does not
+    // re-announce the start, since only the initial start crosses from idle.
+    if (previousStatus === 'idle' && status === 'building') {
+      setAnnouncement(BUILD_STARTED_ANNOUNCEMENT);
+      return;
+    }
+
+    // building -> paused: the user paused the build. The message persists (like
+    // the start message) until the next transition replaces it.
+    if (previousStatus === 'building' && status === 'paused') {
+      setAnnouncement(BUILD_PAUSED_ANNOUNCEMENT);
+      return;
+    }
+
+    // paused -> building: the user resumed a paused build.
+    if (previousStatus === 'paused' && status === 'building') {
+      setAnnouncement(BUILD_RESUMED_ANNOUNCEMENT);
+      return;
+    }
+
+    // building|paused -> idle: the build finished. Announce, then clear the
+    // message so it does not linger for the next screen-reader sweep.
+    if (status === 'idle') {
+      setAnnouncement(BUILD_ENDED_ANNOUNCEMENT);
+      const timer = window.setTimeout(
+        () => setAnnouncement(''),
+        ANNOUNCEMENT_CLEAR_DELAY,
+      );
+      return () => window.clearTimeout(timer);
+    }
+  }, [status, lastRevertedAt]);
+
+  return (
+    <div
+      className="visually-hidden"
+      role="status"
+      aria-live="polite"
+      data-testid={BUILD_ANNOUNCER_TESTID}
+    >
+      {announcement}
+    </div>
+  );
+};
+
+export default BuildStatusAnnouncer;
diff --git a/ui/src/features/aiBuild/FollowEditsScroller.tsx b/ui/src/features/aiBuild/FollowEditsScroller.tsx
new file mode 100644
index 0000000..a6ff234
--- /dev/null
+++ b/ui/src/features/aiBuild/FollowEditsScroller.tsx
@@ -0,0 +1,455 @@
+import { useCallback, useEffect, useRef } from 'react';
+
+import { useAppSelector } from '@/app/hooks';
+import {
+  selectBuildStatus,
+  selectFollowEdits,
+} from '@/features/aiBuild/aiBuildSlice';
+import {
+  computeFollowScrollTop,
+  isNearTarget,
+  stepTowards,
+} from '@/features/aiBuild/followScroll';
+import useActiveComponentRect from '@/features/aiBuild/useActiveComponentRect';
+import { selectEditorViewPortScale } from '@/features/ui/uiSlice';
+import { getBuildStateFlags } from '@/utils/drupal-globals';
+
+import type { RefObject } from 'react';
+
+// Build-state feature flags are read once at module scope, mirroring the slice.
+const buildStateFlags = getBuildStateFlags();
+
+// How close (in pane scroll px) the pane must sit to the anchored target to
+// count as "already there" — used both to skip redundant programmatic scrolls
+// and to decide suspend (scrolled away) vs resume (scrolled back near).
+const NEAR_THRESHOLD_PX = 150;
+
+// The scroll pane carries this marker (see EditorFrame's .editorPane).
+const EDITOR_PANE_SELECTOR = '[data-canvas-editor-pane]';
+
+// --- Animation tuning (Round 2) -------------------------------------------
+// The native `scrollTo({behavior:'smooth'})` covered a full-page distance in
+// ~500ms (~11,000 px/s) — perceived as a jump, and colliding with the iframe
+// buffer-swap crossfade it read as a flicker. We replace it with a timer-driven
+// eased pan (followScroll.stepTowards) that is capped in speed and decelerates
+// into the target, and we hold it off until the crossfade has settled.
+
+// Hard speed cap. A large jump pans at this bounded speed instead of teleporting.
+const MAX_VELOCITY_PX_S = 2200;
+// Exponential-smoothing rate governing the deceleration tail. With the cap
+// above, a full pane-height pan (~900px) completes in ~0.8s; distance below
+// MAX_VELOCITY_PX_S / EASE_FACTOR (~183px) is where it starts easing out.
+const EASE_FACTOR = 12;
+// Animation tick period. A timer (never requestAnimationFrame, which suspends in
+// occluded windows); each tick recomputes from a wall-clock dt so late ticks
+// still move proportionally and the terminal snap guarantees the exact target.
+const ANIM_TICK_MS = 16;
+// Decouple from the buffer-swap crossfade: hold motion off this long after a
+// target change so the swap finishes before the pane starts moving.
+const START_DELAY_MS = 180;
+// Keep the programmatic-scroll guard up this long after motion ends, so the
+// trailing scroll events from our own writes are not read as the user scrolling.
+const AUTO_SCROLL_TAIL_MS = 100;
+// If the pane drifts further than this from the value our last tick wrote, the
+// user scrolled during our animation — cancel and hand off to suspend/resume.
+const USER_INTERVENTION_TOLERANCE_PX = 2;
+// How long after the build ends a pan may still START. A placement landing on
+// the FINAL hop only yields a measurable rect after the preview swap + map
+// parse + 200ms re-measure retries (up to ~5s; see useActiveComponentRect), by
+// which time buildEnded has already fired — without this window the last
+// section would never get its follow pan. 6s covers the full retry budget.
+const POST_BUILD_START_GRACE_MS = 6000;
+
+interface Props {
+  // The .previewContainer element ref; the scroll pane is its marked ancestor.
+  previewContainerRef: RefObject<HTMLDivElement>;
+}
+
+/**
+ * Follow Edits auto-scroller (Phase 8). Renders nothing.
+ *
+ * While a build runs and the Follow Edits toggle is on, the pane auto-scrolls to
+ * keep the component the AI is currently placing or editing anchored near the top
+ * of view (its top at 15% of the pane height). Claude-Code-style suspend/resume:
+ * if the user scrolls away from the active target following suspends, and resumes
+ * when they scroll back near it. With the follow_edits flag off it attaches no
+ * listeners and never scrolls.
+ *
+ * Motion (Round 2): instead of the browser's near-instant smooth scroll, the pane
+ * is animated by a setInterval loop that eases toward the target with a capped
+ * velocity (see followScroll.stepTowards). The loop is held off ~180ms after each
+ * target change so the iframe buffer-swap crossfade settles first, decoupling the
+ * motion from the swap flash. A new target retargets the live loop from the
+ * current position (no teleport); a user scroll or toggling Follow Edits off
+ * cancels it instantly. Build end does NOT cancel: a pan already in flight (or
+ * one whose decouple delay is pending) toward the final placement runs to
+ * completion — it self-terminates on arrival, bounded by the velocity cap.
+ * A pan may also still START within a bounded grace window after the build ends
+ * (POST_BUILD_START_GRACE_MS): a final-hop placement's rect only resolves after
+ * the turn, so its follow pan necessarily begins post-build. Retargeting a live
+ * loop stays building-only, and once the grace window lapses nothing starts —
+ * so post-build content shifts (e.g. images loading) are never tracked beyond
+ * that window. Reduced motion keeps an instant jump to the same 15% target.
+ *
+ * Occlusion: this is decorative motion. In a hidden tab the interval throttles and
+ * the pan degrades to coarse steps — acceptable — but terminal correctness holds:
+ * each tick derives its step from a wall-clock (Date.now) dt, so a late tick moves
+ * proportionally further, and the sub-pixel terminal snap lands exactly on target.
+ *
+ * The active component's rect comes from the shared useActiveComponentRect hook
+ * (flag-agnostic), so this works even when component_spotlight is off. The rect
+ * is in unscaled preview-container coordinates while the pane scrolls the scaled
+ * content, so the target position is converted using getBoundingClientRect deltas
+ * plus the editor scale (see resolveDesiredScrollTop). The anchoring math itself
+ * lives in followScroll.ts.
+ */
+const FollowEditsScroller = ({ previewContainerRef }: Props) => {
+  const status = useAppSelector(selectBuildStatus);
+  const followEdits = useAppSelector(selectFollowEdits);
+  const scale = useAppSelector(selectEditorViewPortScale);
+  const { rect, rectReady, activeUuid } = useActiveComponentRect();
+
+  // True while our own animation (plus its short tail) is settling, so the
+  // suspend listener does not mistake it for the user scrolling away.
+  const isAutoScrollingRef = useRef(false);
+  // True while following is suspended because the user scrolled away.
+  const suspendedRef = useRef(false);
+  // The latest scrollTop that would anchor the active target (or null).
+  const desiredScrollTopRef = useRef<number | null>(null);
+  // Wall-clock time the last build ended (status reached idle from an active
+  // build), or null before any build has ended. Grounds the post-build grace
+  // window during which a final-hop pan may still start.
+  const buildEndedAtRef = useRef<number | null>(null);
+  // Previous status, for detecting the build-end transition.
+  const prevStatusRef = useRef(status);
+
+  // Animation machinery. Timer handles are null when idle.
+  const startDelayTimerRef = useRef<number | null>(null);
+  const animIntervalRef = useRef<number | null>(null);
+  const tailTimerRef = useRef<number | null>(null);
+  // The scrollTop the running loop is easing toward.
+  const animTargetRef = useRef(0);
+  // The scrollTop our last tick wrote (null when idle) — for intervention checks.
+  const lastTickScrollTopRef = useRef<number | null>(null);
+  // Date.now() of the last tick, for the wall-clock dt fed to stepTowards.
+  const lastTickTimeRef = useRef(0);
+
+  // Resolve the scroll pane from the previewContainer's marked ancestor.
+  const getPane = useCallback(
+    (): HTMLElement | null =>
+      (previewContainerRef.current?.closest(
+        EDITOR_PANE_SELECTOR,
+      ) as HTMLElement | null) ?? null,
+    [previewContainerRef],
+  );
+
+  // The scrollTop that anchors the active target in the pane's scroll-content
+  // coordinate space, or null when it cannot be computed yet.
+  const resolveDesiredScrollTop = useCallback((): number | null => {
+    const container = previewContainerRef.current;
+    const pane = getPane();
+    if (!container || !pane || !rectReady) {
+      return null;
+    }
+    const containerRect = container.getBoundingClientRect();
+    const paneRect = pane.getBoundingClientRect();
+    // The hook's rect is in UNSCALED container coordinates; the pane scrolls the
+    // SCALED content. Convert the target's unscaled top into the pane's scroll
+    // coordinate space:
+    //   containerRect.top - paneRect.top : on-screen gap from the pane's visible
+    //                                      top to the (scaled) container top
+    //   + pane.scrollTop                 : -> absolute position in scroll content
+    //   + rect.top * scale               : scaled offset of the target within it
+    const targetTopInPane =
+      containerRect.top - paneRect.top + pane.scrollTop + rect.top * scale;
+    return computeFollowScrollTop({
+      paneScrollTop: pane.scrollTop,
+      paneClientHeight: pane.clientHeight,
+      targetTopInPane,
+      // Clamp to the pane's max scroll so the loop's target is reachable and can
+      // settle rather than chasing a scrollTop the browser will clamp short.
+      maxScrollTop: pane.scrollHeight - pane.clientHeight,
+    });
+  }, [getPane, previewContainerRef, rect.top, rectReady, scale]);
+
+  // Evaluate suspend/resume from the pane's current position: suspend when it
+  // sits more than NEAR_THRESHOLD_PX from the target, resume when back within it.
+  const evaluateSuspendResume = useCallback((pane: HTMLElement): void => {
+    const desired = desiredScrollTopRef.current;
+    if (desired === null) {
+      return;
+    }
+    const near = isNearTarget({
+      paneScrollTop: pane.scrollTop,
+      desiredScrollTop: desired,
+      threshold: NEAR_THRESHOLD_PX,
+    });
+    if (!suspendedRef.current && !near) {
+      suspendedRef.current = true;
+    } else if (suspendedRef.current && near) {
+      suspendedRef.current = false;
+    }
+  }, []);
+
+  // Stop the animation immediately and clear every timer + tracking ref. Used on
+  // user intervention, follow-off, build-end, and unmount.
+  const cancelAnimation = useCallback((): void => {
+    if (startDelayTimerRef.current !== null) {
+      clearTimeout(startDelayTimerRef.current);
+      startDelayTimerRef.current = null;
+    }
+    if (animIntervalRef.current !== null) {
+      clearInterval(animIntervalRef.current);
+      animIntervalRef.current = null;
+    }
+    if (tailTimerRef.current !== null) {
+      clearTimeout(tailTimerRef.current);
+      tailTimerRef.current = null;
+    }
+    isAutoScrollingRef.current = false;
+    lastTickScrollTopRef.current = null;
+  }, []);
+
+  // Motion reached the target: stop the loop but hold the guard for a short tail
+  // so trailing scroll events from our writes are not read as user scrolling.
+  const finishAnimation = useCallback((): void => {
+    if (animIntervalRef.current !== null) {
+      clearInterval(animIntervalRef.current);
+      animIntervalRef.current = null;
+    }
+    if (tailTimerRef.current !== null) {
+      clearTimeout(tailTimerRef.current);
+    }
+    tailTimerRef.current = window.setTimeout(() => {
+      tailTimerRef.current = null;
+      isAutoScrollingRef.current = false;
+      lastTickScrollTopRef.current = null;
+    }, AUTO_SCROLL_TAIL_MS);
+  }, []);
+
+  // One animation tick: detect user intervention, else ease one step toward the
+  // target and finish on arrival.
+  const tick = useCallback((): void => {
+    const pane = getPane();
+    if (!pane) {
+      cancelAnimation();
+      return;
+    }
+    // User-intervention detection: if the pane is not where our last tick left
+    // it (beyond tolerance), the user scrolled — cancel and hand to suspend logic.
+    if (
+      lastTickScrollTopRef.current !== null &&
+      Math.abs(pane.scrollTop - lastTickScrollTopRef.current) >
+        USER_INTERVENTION_TOLERANCE_PX
+    ) {
+      cancelAnimation();
+      evaluateSuspendResume(pane);
+      return;
+    }
+    const now = Date.now();
+    const dtMs = now - lastTickTimeRef.current;
+    lastTickTimeRef.current = now;
+    const { next, done } = stepTowards({
+      current: pane.scrollTop,
+      target: animTargetRef.current,
+      dtMs,
+      maxVelocityPxS: MAX_VELOCITY_PX_S,
+      easeFactor: EASE_FACTOR,
+    });
+    pane.scrollTop = next;
+    // Record what the browser accepted (it may round/clamp) so the next tick's
+    // intervention check compares against the real written position.
+    lastTickScrollTopRef.current = pane.scrollTop;
+    if (done) {
+      finishAnimation();
+    }
+  }, [getPane, cancelAnimation, evaluateSuspendResume, finishAnimation]);
+
+  // Point the animation at `target`. Reduced motion jumps instantly; otherwise a
+  // live loop is retargeted in place (no teleport, no re-delay) and a loop at
+  // rest starts after the decouple delay.
+  const moveToTarget = useCallback(
+    (target: number, prefersReducedMotion: boolean): void => {
+      animTargetRef.current = target;
+
+      if (prefersReducedMotion) {
+        const pane = getPane();
+        if (!pane) {
+          return;
+        }
+        cancelAnimation();
+        // Guard the suspend listener against our own instant jump, then release.
+        isAutoScrollingRef.current = true;
+        pane.scrollTop = target;
+        tailTimerRef.current = window.setTimeout(() => {
+          tailTimerRef.current = null;
+          isAutoScrollingRef.current = false;
+        }, AUTO_SCROLL_TAIL_MS);
+        return;
+      }
+
+      // Already animating (or waiting out the decouple delay): just retarget the
+      // running loop toward the new target from the current position.
+      if (
+        animIntervalRef.current !== null ||
+        startDelayTimerRef.current !== null
+      ) {
+        isAutoScrollingRef.current = true;
+        return;
+      }
+
+      // Starting from rest: hold the guard through the decouple delay + motion.
+      isAutoScrollingRef.current = true;
+      if (tailTimerRef.current !== null) {
+        clearTimeout(tailTimerRef.current);
+        tailTimerRef.current = null;
+      }
+      startDelayTimerRef.current = window.setTimeout(() => {
+        startDelayTimerRef.current = null;
+        const pane = getPane();
+        if (!pane) {
+          isAutoScrollingRef.current = false;
+          return;
+        }
+        lastTickScrollTopRef.current = pane.scrollTop;
+        lastTickTimeRef.current = Date.now();
+        animIntervalRef.current = window.setInterval(tick, ANIM_TICK_MS);
+      }, START_DELAY_MS);
+    },
+    [getPane, cancelAnimation, tick],
+  );
+
+  // Keep the desired scrollTop fresh for the suspend/resume distance check as the
+  // target, scale, or measured rect change — independent of whether we scroll.
+  useEffect(() => {
+    if (!buildStateFlags.follow_edits) {
+      return;
+    }
+    desiredScrollTopRef.current = resolveDesiredScrollTop();
+  }, [resolveDesiredScrollTop]);
+
+  // Toggling Follow Edits on (including from off) starts fresh: clear any prior
+  // suspension so the next target is followed again.
+  useEffect(() => {
+    if (buildStateFlags.follow_edits && followEdits) {
+      suspendedRef.current = false;
+    }
+  }, [followEdits]);
+
+  // Record when the build ends (status leaves building/paused for idle). This
+  // grounds the post-build grace window below; declared BEFORE the trigger
+  // effect so the timestamp exists on the very render the status flips.
+  useEffect(() => {
+    if (prevStatusRef.current !== 'idle' && status === 'idle') {
+      buildEndedAtRef.current = Date.now();
+    }
+    prevStatusRef.current = status;
+  }, [status]);
+
+  // Auto-scroll to the active target when it changes while building and
+  // enabled — or within the post-build grace window, for a final-hop placement
+  // whose rect only resolves after buildEnded (its uuid survives the turn in
+  // the slice for exactly this).
+  useEffect(() => {
+    if (!buildStateFlags.follow_edits) {
+      return;
+    }
+    const isBuilding = status === 'building';
+    const withinPostBuildGrace =
+      status === 'idle' &&
+      buildEndedAtRef.current !== null &&
+      Date.now() - buildEndedAtRef.current <= POST_BUILD_START_GRACE_MS;
+    if (
+      (!isBuilding && !withinPostBuildGrace) ||
+      !followEdits ||
+      suspendedRef.current ||
+      !rectReady
+    ) {
+      return;
+    }
+    const pane = getPane();
+    const desired = resolveDesiredScrollTop();
+    if (!pane || desired === null) {
+      return;
+    }
+    desiredScrollTopRef.current = desired;
+    const prefersReducedMotion = window.matchMedia(
+      '(prefers-reduced-motion: reduce)',
+    ).matches;
+    const animating =
+      animIntervalRef.current !== null || startDelayTimerRef.current !== null;
+    // Retargeting a live loop stays building-only: within the grace window only
+    // a fresh start is permitted, so a pan already gliding toward the final
+    // placement is never re-aimed at post-build content shifts.
+    if (!isBuilding && animating) {
+      return;
+    }
+    // At rest and already anchored enough: don't fight the user or re-trigger a
+    // scroll. While the loop is live we still retarget it (below) to the newest
+    // target so it never overshoots to a stale one.
+    if (
+      !animating &&
+      isNearTarget({
+        paneScrollTop: pane.scrollTop,
+        desiredScrollTop: desired,
+        threshold: NEAR_THRESHOLD_PX,
+      })
+    ) {
+      return;
+    }
+    moveToTarget(desired, prefersReducedMotion);
+  }, [
+    activeUuid,
+    rectReady,
+    status,
+    followEdits,
+    getPane,
+    resolveDesiredScrollTop,
+    moveToTarget,
+  ]);
+
+  // Cancel any in-flight animation the moment Follow Edits is toggled off (the
+  // trigger effect above only skips starting; it does not stop a loop). Build
+  // end deliberately does NOT cancel: the pan toward the final placement — even
+  // one still waiting out its start delay — runs to completion so the last
+  // section lands on the 15% anchor instead of stopping mid-flight. It
+  // self-terminates on arrival, and after the post-build grace window lapses
+  // nothing can start, so there is no continuous tracking after the turn ends.
+  useEffect(() => {
+    if (!buildStateFlags.follow_edits) {
+      return;
+    }
+    if (!followEdits) {
+      cancelAnimation();
+    }
+  }, [followEdits, cancelAnimation]);
+
+  // Suspend when the user scrolls away from the active target; resume when they
+  // scroll back near it. Passive listener; none attached when the flag is off.
+  // Scrolls during our own animation are ignored here (isAutoScrollingRef) — the
+  // animation tick detects user intervention itself and hands back to this logic.
+  useEffect(() => {
+    if (!buildStateFlags.follow_edits) {
+      return;
+    }
+    const pane = getPane();
+    if (!pane) {
+      return;
+    }
+    const onScroll = () => {
+      if (isAutoScrollingRef.current) {
+        return;
+      }
+      evaluateSuspendResume(pane);
+    };
+    pane.addEventListener('scroll', onScroll, { passive: true });
+    return () => pane.removeEventListener('scroll', onScroll);
+  }, [getPane, evaluateSuspendResume]);
+
+  // Stop the animation and clear all timers on unmount.
+  useEffect(() => () => cancelAnimation(), [cancelAnimation]);
+
+  return null;
+};
+
+export default FollowEditsScroller;
diff --git a/ui/src/features/aiBuild/PlanSkeletons.module.css b/ui/src/features/aiBuild/PlanSkeletons.module.css
new file mode 100644
index 0000000..b9b7f04
--- /dev/null
+++ b/ui/src/features/aiBuild/PlanSkeletons.module.css
@@ -0,0 +1,129 @@
+/**
+ * Plan "gen-cards" rendered at the plan's insertion point while the AI builds a
+ * planned page (Phase 6). One card renders per still-unplaced section; each is a
+ * shaped placeholder signalling active generation with a bluish-translucent
+ * shimmer sweeping across the card fill (animated background-position — the
+ * card's only motion) inside a static 1px base ring that gives the card
+ * definition. The travelling-line border pulse that used to live here moved to
+ * the active-component spotlight (ActiveComponentSpotlight.module.css), where it
+ * marks the one component the AI is actually working on. With no gradient left
+ * to mask, the ring is a plain border — no masked ::before plumbing needed. The
+ * card center has no background, so the page behind shows through the
+ * translucent shimmer.
+ *
+ * Placement: the strip is absolutely positioned inside .previewContainer.
+ * Normally PlanSkeletons overrides `top` inline to sit over the spacer that
+ * usePlanSpacerAnchor injects into the preview's content region (the real
+ * insertion point, above the footer). The `top: 100%` here is the FALLBACK for
+ * when that region cannot be resolved — just below all rendered content, kept
+ * in sync by useSyncIframeHeightToContent — so cards are never invisible.
+ * .previewContainer does not clip (no overflow: hidden), and
+ * pointer-events: none guarantees the strip can never intercept input. Boxes
+ * stop rendering when placedCount advances (or the plan clears on build end),
+ * so there is no exit animation.
+ *
+ * Colors map to the Radix Themes gray scale in use — grayColor is unset, so
+ * Radix auto-pairs the blue accent with slate, and --gray-* resolves to slate.
+ * The ring base is the dark neutral alpha step --gray-a10; the section-title
+ * label is quiet --gray-10. The shimmer stops stay literal: a bluish
+ * translucency (dark-blue .25 / light-blue .60) tuned to read against white,
+ * with no close Radix alpha peer.
+ *
+ * A11y: the strip is aria-hidden and carries no per-card role/aria-busy. Build
+ * status is announced once, centrally, by BuildStatusAnnouncer; N cards each
+ * announcing would be noisy. This deliberately deviates from the generic spec.
+ *
+ * Reduced motion: the shimmer stops and holds a static translucent fill; the
+ * ring is already static.
+ */
+
+.strip {
+  /* Card heights by planned-section size (Phase 6 sizes): short is the base
+     height for slim bands (banners, CTAs…); tall is 4x it for content-heavy
+     sections (heroes, feature grids…). The size is agent-declared with a
+     keyword-heuristic fallback (see inferPlanSectionSize in aiBuildSlice). */
+  --plan-card-height-short: 180px;
+  --plan-card-height-tall: calc(var(--plan-card-height-short) * 4);
+
+  position: absolute;
+  top: 100%;
+  right: 0;
+  left: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+  margin-top: 12px;
+  pointer-events: none;
+}
+
+.card {
+  /* Spec tokens (see file header for the Radix mapping). */
+  --border-base: var(--gray-a10);
+  --border-w: 1px;
+  --shimmer-edge: rgb(64, 76, 104, 0.25);
+  --shimmer-sweep: rgb(150, 170, 220, 0.6);
+  --shimmer-speed: 2.6s;
+
+  position: relative;
+  box-sizing: border-box;
+  width: 100%;
+  min-height: var(--plan-card-height-short);
+  /* Static base ring; no background — the card center stays transparent so the
+     canvas shows through. */
+  border: var(--border-w) solid var(--border-base);
+  border-radius: 3px;
+}
+
+/* Content-heavy planned section: the card grows to the tall height. */
+.cardTall {
+  min-height: var(--plan-card-height-tall);
+}
+
+/* Shimmer fill — a bluish-translucent 3-stop sweep nested inside the ring
+   (inset: 0 positions against the padding box, i.e. inside the border). */
+.shimmer {
+  position: absolute;
+  animation: canvas-plan-shimmer var(--shimmer-speed) linear infinite;
+  border-radius: 2px;
+  background-image: linear-gradient(
+    90deg,
+    var(--shimmer-edge) 25%,
+    var(--shimmer-sweep) 50%,
+    var(--shimmer-edge) 75%
+  );
+  background-size: 200% 100%;
+  inset: 0;
+}
+
+@keyframes canvas-plan-shimmer {
+  from {
+    background-position: 100% 0;
+  }
+
+  to {
+    background-position: -100% 0;
+  }
+}
+
+/* Quiet section-title label carrying plan context (the generic spec has none). */
+.title {
+  position: absolute;
+  z-index: 2;
+  top: 8px;
+  left: 12px;
+  letter-spacing: 0.01em;
+  color: var(--gray-10);
+  font-size: 12px;
+  font-weight: 500;
+}
+
+/* Respect reduced-motion: hold a static translucent fill, drop the sweep. */
+@media (prefers-reduced-motion: reduce) {
+  .shimmer {
+    animation: none;
+    background-image: linear-gradient(
+      var(--shimmer-edge),
+      var(--shimmer-edge)
+    );
+  }
+}
diff --git a/ui/src/features/aiBuild/PlanSkeletons.tsx b/ui/src/features/aiBuild/PlanSkeletons.tsx
new file mode 100644
index 0000000..547053f
--- /dev/null
+++ b/ui/src/features/aiBuild/PlanSkeletons.tsx
@@ -0,0 +1,99 @@
+import { useRef } from 'react';
+import clsx from 'clsx';
+
+import { useAppSelector } from '@/app/hooks';
+import {
+  selectIsBuildActive,
+  selectPlacedCount,
+  selectRemainingPlan,
+} from '@/features/aiBuild/aiBuildSlice';
+import { PLAN_SKELETON_TESTID } from '@/features/aiBuild/constants';
+import usePlanSpacerAnchor from '@/features/aiBuild/usePlanSpacerAnchor';
+
+import styles from './PlanSkeletons.module.css';
+
+/**
+ * "Generating" gen-card strip at the plan's insertion point (Phase 6).
+ *
+ * The agent's set_build_plan tool declares the sections it will build; one
+ * gen-card renders per section that is still unplaced — a shaped placeholder
+ * that signals active generation with a translucent shimmer sweep inside a
+ * static base ring (see PlanSkeletons.module.css; the travelling ring pulse
+ * moved to ActiveComponentSpotlight). As each real section lands
+ * (componentPlaced advances placedCount) its card stops rendering, and when the
+ * build ends early any remaining cards vanish because the slice clears the
+ * plan.
+ *
+ * Placement: planned sections land in the page's CONTENT region, above the
+ * footer — so the cards must appear there, not below all rendered content.
+ * usePlanSpacerAnchor maintains a decorative spacer in BOTH preview buffer
+ * documents' content regions (client-side only; the srcdoc is
+ * server-regenerated on every preview POST, so the injection can never reach
+ * autosave — and pre-spacing the hidden buffer is what keeps the footer from
+ * jumping at each swap) and the strip anchors over the active one via an
+ * inline `top`. While the region cannot be resolved the strip falls back to
+ * top: 100% of .previewContainer — whose height is synced to the preview
+ * content by useSyncIframeHeightToContent — so the cards are never invisible.
+ * Either way the strip stays inside .previewContainer, never touches or
+ * portals over the iframe, and is pointer-events: none.
+ *
+ * The plan_skeletons flag is enforced upstream in the slice (planReceived
+ * ignores the plan when the flag is off, so the remaining list stays empty and
+ * this renders nothing); no separate flag check is needed here.
+ *
+ * Exit: cards simply stop rendering when placedCount advances. A true CSS exit
+ * transition on unmount would need extra per-card exit state (React unmounts
+ * removed list items immediately) or an animation dependency, neither of which
+ * is warranted here — the shimmer/pulse are steady-state generation motions.
+ *
+ * A11y: the strip is aria-hidden and cards carry no per-card role/aria-busy.
+ * Build status is announced once, centrally, by BuildStatusAnnouncer; N cards
+ * each announcing would be noisy. This deliberately deviates from the generic
+ * gen-card spec, which suggests per-card status roles.
+ */
+const PlanSkeletons = () => {
+  const remaining = useAppSelector(selectRemainingPlan);
+  const placedCount = useAppSelector(selectPlacedCount);
+  const isBuildActive = useAppSelector(selectIsBuildActive);
+  const stripRef = useRef<HTMLDivElement | null>(null);
+
+  // The spacer/anchor lifecycle keys off one number: remaining sections while
+  // the build is active, 0 otherwise (which tears the spacer down).
+  const activeCount = isBuildActive ? remaining.length : 0;
+  const anchorTop = usePlanSpacerAnchor(stripRef, activeCount);
+
+  if (activeCount === 0) {
+    return null;
+  }
+
+  return (
+    <div
+      className={styles.strip}
+      aria-hidden="true"
+      ref={stripRef}
+      // Anchored over the injected spacer when available; otherwise the CSS
+      // top: 100% fallback applies.
+      style={anchorTop === null ? undefined : { top: `${anchorTop}px` }}
+    >
+      {remaining.map((section, index) => (
+        // Key by absolute plan position (placedCount + slice index) so each
+        // underlying section keeps a stable key as the strip shrinks from the
+        // front, and React unmounts the placed box rather than the last one.
+        <div
+          key={placedCount + index}
+          // Card height follows the normalized section size (tall for
+          // content-heavy sections, short for slim bands).
+          className={clsx(styles.card, {
+            [styles.cardTall]: section.size === 'tall',
+          })}
+          data-testid={PLAN_SKELETON_TESTID}
+        >
+          <span className={styles.title}>{section.title}</span>
+          <div className={styles.shimmer} />
+        </div>
+      ))}
+    </div>
+  );
+};
+
+export default PlanSkeletons;
diff --git a/ui/src/features/aiBuild/aiBuildSlice.ts b/ui/src/features/aiBuild/aiBuildSlice.ts
new file mode 100644
index 0000000..57a4f66
--- /dev/null
+++ b/ui/src/features/aiBuild/aiBuildSlice.ts
@@ -0,0 +1,337 @@
+import { createSelector } from '@reduxjs/toolkit';
+
+import { createAppSlice } from '@/app/createAppSlice';
+import { STRUCTURAL_TOOL_NAMES } from '@/features/aiBuild/constants';
+import { getBuildStateFlags } from '@/utils/drupal-globals';
+
+import type { PayloadAction } from '@reduxjs/toolkit';
+import type { RootLayoutModel } from '@/features/layout/layoutModelSlice';
+
+// Card size of a planned section (Phase 6): 'tall' for content-heavy blocks
+// (heroes, feature grids, stats…), 'short' for slim bands (banners, CTAs…).
+export type PlanSectionSize = 'short' | 'tall';
+
+// One planned section of an approved build, as declared by the agent's
+// set_build_plan tool. `componentId` is the catalog id the agent intends to
+// place (null when the agent named a section but not a component); `title` is
+// the short human label shown on the gen-card (Phase 6); `size` picks the
+// card height and is always normalized by planReceived (agent-declared value
+// when valid, keyword heuristic otherwise).
+export interface PlanSection {
+  componentId: string | null;
+  title: string;
+  size: PlanSectionSize;
+}
+
+// A plan section as it arrives from the tool output (via AiWizard's
+// buildPlanHandler), before planReceived normalizes it: componentId may be
+// absent and size is untrusted free text until validated.
+export interface IncomingPlanSection {
+  componentId?: string | null;
+  title: string;
+  size?: string | null;
+}
+
+// Keywords marking a planned section as content-heavy → a tall card. Kept as
+// one visible regex so tuning is a one-line change.
+export const TALL_SECTION_PATTERN =
+  /hero|feature|grid|stats|testimonial|faq|pricing|gallery|carousel|comparison/i;
+
+/**
+ * Infers a planned section's card size when the agent did not declare a valid
+ * one: sections whose title or component id carries a content-heavy keyword
+ * (TALL_SECTION_PATTERN) read as tall, everything else as short. Explicit
+ * agent-declared sizes win in planReceived; this is only the fallback.
+ */
+export const inferPlanSectionSize = (
+  title: string,
+  componentId: string | null,
+): PlanSectionSize =>
+  TALL_SECTION_PATTERN.test(`${title} ${componentId ?? ''}`) ? 'tall' : 'short';
+
+// A pre-turn snapshot of the layoutModel present state ({ layout, model }). It is
+// exactly the structural payload `setLayoutModel` needs to restore the layout in
+// one action (Phase 5 turn revert). Typed from the layout slice so the shape can
+// never drift from what the restore dispatch expects.
+export type TurnSnapshot = RootLayoutModel;
+
+// Build-state feature flags are read once at module scope. drupalSettings is
+// injected before the app bundle runs and does not change during a session, so
+// a single read keeps the selectors synchronous and cheap.
+const buildStateFlags = getBuildStateFlags();
+
+export type AiBuildStatus = 'idle' | 'building' | 'paused';
+
+export interface AiBuildState {
+  status: AiBuildStatus;
+  requestId: string | null;
+  startedAt: number | null;
+  // Phase 1: true for the whole turn while the AI is building. Phase 3 releases
+  // it mid-turn once the hop tools prove the turn is non-structural.
+  locked: boolean;
+  // Cumulative function names of the tools the model selected this turn; Phase 3
+  // gates the lock on whether any is structural (see STRUCTURAL_TOOL_NAMES).
+  toolsSelected: string[];
+  // Ordered sections the agent declared it will build (Phase 6). One gray
+  // skeleton renders per remaining section; empty when the plan_skeletons flag
+  // is off or no plan was received.
+  plannedComponents: PlanSection[];
+  // How many planned sections have been placed so far (Phase 6). The skeleton
+  // strip renders plannedComponents.slice(placedCount).
+  placedCount: number;
+  // The component the per-component spotlight targets (Phase 7): the section
+  // currently being placed or the component currently being edited. Set per
+  // operation by AiWizard and cleared between operations. It SURVIVES buildEnded
+  // (like turnSnapshot) and is reset by the next buildStarted: a placement that
+  // lands on the final hop only yields a measurable rect after the preview swap
+  // and re-measure retries, by which time the build has already ended — the
+  // Phase 8 follow pan needs the uuid to still resolve post-turn. The spotlight
+  // is unaffected: selectIsPerComponentSpotlightActive also requires an active
+  // build.
+  activeComponentUuid: string | null;
+  // Phase 8: whether the viewport auto-scrolls to keep the component the AI is
+  // working on in view. Persists across turns (survives buildEnded) so the
+  // user's toggle choice is remembered for the next build.
+  followEdits: boolean;
+  // Pre-turn layoutModel snapshot captured at buildStarted, used by the Phase 5
+  // "Stop and revert all changes" control. It outlives the turn (survives
+  // buildEnded) so a completed turn can still be reverted, and is cleared only by
+  // the next buildStarted (which overwrites it) or snapshotConsumed.
+  turnSnapshot: TurnSnapshot | null;
+  // Timestamp of the last completed revert. Bumped by buildReverted so the
+  // status announcer can speak the revert message exactly once, taking
+  // precedence over the generic "build finished" message buildEnded triggers.
+  lastRevertedAt: number | null;
+}
+
+export const initialState: AiBuildState = {
+  status: 'idle',
+  requestId: null,
+  startedAt: null,
+  locked: false,
+  toolsSelected: [],
+  plannedComponents: [],
+  placedCount: 0,
+  activeComponentUuid: null,
+  followEdits: true,
+  turnSnapshot: null,
+  lastRevertedAt: null,
+};
+
+export const aiBuildSlice = createAppSlice({
+  name: 'aiBuild',
+  initialState,
+  reducers: (create) => ({
+    buildStarted: create.reducer(
+      (
+        state,
+        action: PayloadAction<{
+          requestId: string;
+          turnSnapshot?: TurnSnapshot;
+        }>,
+      ) => {
+        state.status = 'building';
+        state.locked = true;
+        state.startedAt = Date.now();
+        state.requestId = action.payload.requestId;
+        // The previous turn's active component outlives buildEnded (final-hop
+        // placements resolve their rect post-turn for the last follow pan), so
+        // each new turn starts with a clean target here instead.
+        state.activeComponentUuid = null;
+        // Overwrite any prior turn's snapshot with this turn's pre-turn state.
+        // Absent (older callers / no snapshot available) clears it, so a stale
+        // snapshot can never outlive the turn that captured it.
+        state.turnSnapshot = action.payload.turnSnapshot ?? null;
+      },
+    ),
+    hopReceived: create.reducer(
+      (state, action: PayloadAction<{ toolsSelected?: string[] }>) => {
+        // Merge this hop's tool function names into the cumulative set.
+        const incoming = action.payload?.toolsSelected;
+        if (incoming?.length) {
+          state.toolsSelected = Array.from(
+            new Set([...state.toolsSelected, ...incoming]),
+          );
+        }
+        // Phase 3 smart-lock timing. Only re-evaluate while actively building —
+        // never while paused, where the lock is held deliberately. With the flag
+        // off this is a no-op and `locked` keeps its Phase 1 whole-turn value.
+        if (buildStateFlags.smart_lock_timing && state.status === 'building') {
+          // No tools seen yet (research-only or clarifying hops) is conservative:
+          // stay locked. A structural name locks — and re-locks even after an
+          // earlier unlock, so a build that opens with research calls before
+          // place_components does not flicker unlocked.
+          state.locked =
+            state.toolsSelected.length === 0
+              ? true
+              : state.toolsSelected.some((name) =>
+                  STRUCTURAL_TOOL_NAMES.includes(name),
+                );
+        }
+      },
+    ),
+    planReceived: create.reducer(
+      (state, action: PayloadAction<IncomingPlanSection[]>) => {
+        // Flag off → ignore the plan entirely so no skeletons ever render and no
+        // state is stored; everything else about the build is unchanged.
+        if (!buildStateFlags.plan_skeletons) {
+          return;
+        }
+        // Store the ordered list in the fixed {componentId, title, size} shape
+        // and reset progress: this plan starts with nothing placed. Size
+        // normalization: an explicit valid 'short'/'tall' wins; anything else
+        // (absent, or an invalid value from the tool) falls back to the
+        // keyword heuristic — never reject the plan over a cosmetic field.
+        state.plannedComponents = action.payload.map((section) => {
+          const componentId = section.componentId ?? null;
+          return {
+            componentId,
+            title: section.title,
+            size:
+              section.size === 'short' || section.size === 'tall'
+                ? section.size
+                : inferPlanSectionSize(section.title, componentId),
+          };
+        });
+        state.placedCount = 0;
+      },
+    ),
+    componentPlaced: create.reducer(
+      (state, _action: PayloadAction<{ componentId: string }>) => {
+        // Advance by position, not by id match: even when the placed
+        // component's id differs from plannedComponents[placedCount].componentId
+        // (order drift), still advance so one skeleton drops per placement.
+        if (
+          state.plannedComponents.length > 0 &&
+          state.placedCount < state.plannedComponents.length
+        ) {
+          state.placedCount += 1;
+        }
+      },
+    ),
+    buildPaused: create.reducer((state) => {
+      // Only a running build can be paused; from idle or paused this is a no-op.
+      if (state.status === 'building') {
+        state.status = 'paused';
+      }
+    }),
+    buildResumed: create.reducer((state) => {
+      // Only a paused build can resume; from idle or building this is a no-op.
+      if (state.status === 'paused') {
+        state.status = 'building';
+      }
+    }),
+    buildEnded: create.reducer((state) => {
+      // Reset to idle/unlocked. This is the single fail-open exit: it must
+      // return the same idle/unlocked result from any status (building or
+      // paused). `followEdits`, `turnSnapshot`, and `activeComponentUuid`
+      // outlive a single turn and are intentionally preserved — the last one
+      // because a final-hop placement's rect only becomes measurable after the
+      // turn ends and the Phase 8 follow pan still needs to resolve it; the
+      // next buildStarted replaces it.
+      state.status = 'idle';
+      state.locked = false;
+      state.requestId = null;
+      state.startedAt = null;
+      state.toolsSelected = [];
+      state.plannedComponents = [];
+      state.placedCount = 0;
+    }),
+    setFollowEdits: create.reducer((state, action: PayloadAction<boolean>) => {
+      state.followEdits = action.payload;
+    }),
+    // Marks which just-placed or just-edited component the per-component
+    // spotlight (Phase 7) targets. AiWizard dispatches it before each top-level
+    // placement and before each component edit; null clears it. It survives
+    // buildEnded (see the state doc) and is reset by the next buildStarted.
+    setActiveComponent: create.reducer(
+      (state, action: PayloadAction<string | null>) => {
+        state.activeComponentUuid = action.payload;
+      },
+    ),
+    // Clears the pre-turn snapshot once a revert has consumed it. Keeps the
+    // revert control from lingering after the layout has already been restored.
+    snapshotConsumed: create.reducer((state) => {
+      state.turnSnapshot = null;
+    }),
+    // Records that a revert just happened. The status announcer watches this
+    // timestamp so it can announce the revert exactly once (see
+    // BuildStatusAnnouncer); it does not touch the snapshot itself.
+    buildReverted: create.reducer((state, action: PayloadAction<number>) => {
+      state.lastRevertedAt = action.payload;
+    }),
+  }),
+  selectors: {
+    selectBuildStatus: (aiBuild): AiBuildStatus => aiBuild.status,
+    selectIsBuildActive: (aiBuild): boolean => aiBuild.status !== 'idle',
+    // Phase 8: the "Follow Edits" toggle state (auto-scroll to the active
+    // component during a build). Gating on the follow_edits flag lives in the
+    // scroller and the toolbar toggle, so this stays the plain stored value.
+    selectFollowEdits: (aiBuild): boolean => aiBuild.followEdits,
+    selectTurnSnapshot: (aiBuild): TurnSnapshot | null => aiBuild.turnSnapshot,
+    selectLastRevertedAt: (aiBuild): number | null => aiBuild.lastRevertedAt,
+    selectPlannedComponents: (aiBuild): PlanSection[] =>
+      aiBuild.plannedComponents,
+    selectPlacedCount: (aiBuild): number => aiBuild.placedCount,
+    selectIsCanvasLocked: (aiBuild): boolean =>
+      aiBuild.status !== 'idle' && aiBuild.locked && buildStateFlags.build_lock,
+    // Phase 7 suppresses this whole-viewport glow while the per-component
+    // spotlight is showing, but that suppression depends on the component's
+    // DOM-derived rect being available and so lives in Viewport, not here. This
+    // selector stays the plain flag-gated eligibility (build active + flag on).
+    selectIsGlowing: (aiBuild): boolean =>
+      aiBuild.status !== 'idle' && buildStateFlags.build_glow,
+    selectActiveComponentUuid: (aiBuild): string | null =>
+      aiBuild.activeComponentUuid,
+    // True when the per-component spotlight (Phase 7) should try to resolve a
+    // rect: the flag is on, a component is marked active, and a build is
+    // running. Whether the spotlight actually renders also depends on the
+    // component's rect being available in the DOM map — tracked in the
+    // component, not here, to keep DOM-derived state out of Redux.
+    selectIsPerComponentSpotlightActive: (aiBuild): boolean =>
+      aiBuild.status !== 'idle' &&
+      aiBuild.activeComponentUuid !== null &&
+      buildStateFlags.component_spotlight,
+  },
+});
+
+// Action creators are generated for each case reducer function.
+export const {
+  buildStarted,
+  hopReceived,
+  planReceived,
+  componentPlaced,
+  buildPaused,
+  buildResumed,
+  buildEnded,
+  setFollowEdits,
+  setActiveComponent,
+  snapshotConsumed,
+  buildReverted,
+} = aiBuildSlice.actions;
+
+// Selectors returned by `slice.selectors` take the root state as their first
+// argument.
+export const {
+  selectBuildStatus,
+  selectIsBuildActive,
+  selectFollowEdits,
+  selectIsCanvasLocked,
+  selectIsGlowing,
+  selectActiveComponentUuid,
+  selectIsPerComponentSpotlightActive,
+  selectTurnSnapshot,
+  selectLastRevertedAt,
+  selectPlannedComponents,
+  selectPlacedCount,
+} = aiBuildSlice.selectors;
+
+// The sections still awaiting placement — the ones with a live skeleton box.
+// Memoized with createSelector (the codebase pattern for derived selectors that
+// build a new array, e.g. selectLayoutForRegion) so the returned slice keeps a
+// stable reference across store updates that leave the plan and count unchanged.
+export const selectRemainingPlan = createSelector(
+  [selectPlannedComponents, selectPlacedCount],
+  (plannedComponents, placedCount): PlanSection[] =>
+    plannedComponents.slice(placedCount),
+);
diff --git a/ui/src/features/aiBuild/buildAbortRegistry.ts b/ui/src/features/aiBuild/buildAbortRegistry.ts
new file mode 100644
index 0000000..d9f9a25
--- /dev/null
+++ b/ui/src/features/aiBuild/buildAbortRegistry.ts
@@ -0,0 +1,44 @@
+// Module-scope handle to the AbortController for the active AI build turn. It
+// lets non-React code (and later phases' explicit stop control) abort the
+// in-flight hop loop without threading the controller through React state.
+
+let activeBuildAbort: AbortController | null = null;
+
+/**
+ * Registers (or clears) the AbortController for the active build turn.
+ */
+export function setActiveBuildAbort(controller: AbortController | null): void {
+  activeBuildAbort = controller;
+}
+
+/**
+ * Aborts the active build turn if one is registered.
+ *
+ * The controller stays registered after aborting: the hop loop's `.finally`
+ * (or the AiWizard unmount cleanup) owns clearing it via setActiveBuildAbort.
+ * Keeping it registered lets in-flight message handlers observe the aborted
+ * signal through isActiveBuildAborted() and stop applying mutations mid-loop.
+ *
+ * @returns True if a controller was registered and aborted, otherwise false.
+ */
+export function abortActiveBuild(): boolean {
+  if (activeBuildAbort) {
+    activeBuildAbort.abort();
+    return true;
+  }
+  return false;
+}
+
+/**
+ * Whether the registered build turn has been aborted.
+ *
+ * True only while a controller is still registered AND its signal is aborted —
+ * i.e. the window between an abort (stop-and-revert, unmount) and the hop
+ * loop's `.finally` clearing the registry. Multi-step message handlers check
+ * this before each mutation so a revert cannot race their remaining dispatches.
+ *
+ * @returns True when the active build turn has been aborted.
+ */
+export function isActiveBuildAborted(): boolean {
+  return activeBuildAbort?.signal.aborted ?? false;
+}
